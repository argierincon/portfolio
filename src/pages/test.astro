---
// src/pages/index.astro
import "../styles/global.css";

interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: "About", href: "#about" },
  { label: "Blog", href: "#blog" },
  { label: "Download", href: "#download" },
];

// Reemplaza estas rutas con tus imágenes en src/assets/ o public/
const leftPortrait =
  "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=700&q=80";
const rightPortrait =
  "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=700&q=80";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hero Collage · Design System</title>
  </head>

  <body class="min-h-screen bg-vellum-sheet text-easton-blue-500 selection:bg-lunar-yellow-500 selection:text-easton-blue-500 overflow-x-hidden">
    <!-- Contenedor principal con líneas guía sutiles de fondo estilo editorial -->
    <div class="relative mx-auto min-h-screen max-w-7xl px-6 sm:px-10 lg:px-14">
      <!-- Líneas verticales decorativas sutiles (como en la referencia) -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 mx-auto max-w-7xl px-6 sm:px-10 lg:px-14"
      >
        <div class="grid h-full grid-cols-4 border-x border-easton-blue-100/70">
          <div class="border-r border-easton-blue-100/70"></div>
          <div class="border-r border-easton-blue-100/70"></div>
          <div class="border-r border-easton-blue-100/70"></div>
          <div></div>
        </div>
      </div>

      <!-- NAVBAR SUPERIOR -->
      <header class="relative z-20 flex items-center gap-10 pt-8 pb-6 sm:gap-16 sm:pt-10">
        <!-- Logo geométrico 3x2 inspirado en la referencia usando tu paleta -->
        <a
          href="/"
          aria-label="Inicio"
          class="group grid grid-cols-3 gap-0.5 transition-transform duration-200 hover:scale-105"
        >
          <span class="h-3.5 w-3.5 bg-mashle-red-500"></span>
          <span class="h-3.5 w-3.5 rounded-full bg-lunar-yellow-700"></span>
          <span class="h-3.5 w-3.5 rounded-full bg-easton-blue-600"></span>
          <span class="h-3.5 w-3.5 rounded-full bg-wand-brown-600"></span>
          <span class="h-3.5 w-3.5 rounded-tl-full bg-easton-blue-500"></span>
          <span class="h-3.5 w-3.5 rounded-tr-full bg-mashle-red-700"></span>
        </a>

        <nav aria-label="Navegación principal">
          <ul class="flex items-center gap-7 sm:gap-11">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="subtitle-2 text-obsidian-ink transition-colors hover:text-mashle-red-500"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>

      <!-- HERO SECTION: 2 COLUMNAS -->
      <main class="relative z-10 grid grid-cols-1 items-center gap-14 pt-6 pb-20 lg:grid-cols-12 lg:gap-8 lg:pt-4 lg:pb-16">
        <!-- COLUMNA IZQUIERDA: COPY + CTA -->
        <section class="lg:col-span-5 xl:col-span-5">
          <p class="subtitle-1 text-obsidian-ink">Meet Millions Of</p>

          <h1 class="mt-3 tracking-tight text-easton-blue-500">
            Lesbian,
            <br />
            Bisexual,
            <br />
            &amp; Queer People
          </h1>

          <div class="mt-9">
            <a
              href="#download"
              class="text-button inline-flex items-center justify-center rounded-md border-[1.5px] border-mashle-red-500 bg-vellum-sheet px-7 py-3 text-mashle-red-500 shadow-[0_6px_16px_-4px_rgba(197,30,37,0.18)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-mashle-red-500 hover:text-vellum-sheet focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mashle-red-500"
            >
              Download App
            </a>
          </div>
        </section>

        <!-- COLUMNA DERECHA: COLLAGE GEOMÉTRICO -->
        <section
          aria-label="Composición visual"
          class="relative flex justify-center lg:col-span-7 lg:justify-end"
        >
          <!-- Lienzo con proporción controlada para mantener la geometría intacta en cualquier pantalla -->
          <div class="relative w-full max-w-[540px] aspect-[540/620]">
            <!-- 1. Rectángulo superior (Mashle Red) -->
            <div
              aria-hidden="true"
              class="absolute top-0 left-[12%] h-[11%] w-[32%] bg-mashle-red-500"
            ></div>

            <!-- 2. Círculo superior derecho (Wand Brown) -->
            <div
              aria-hidden="true"
              class="absolute top-0 left-[44%] aspect-square w-[18.5%] rounded-full bg-wand-brown-600"
            ></div>

            <!-- 3. Arco izquierdo con retrato 1 (esquina superior izquierda e inferior derecha redondeadas) -->
            <div class="absolute top-[11%] left-[12%] h-[58%] w-[51%] overflow-hidden rounded-tl-[135px] rounded-br-[135px] bg-easton-blue-300 shadow-xs">
              <img
                src={leftPortrait}
                alt="Retrato izquierdo"
                class="h-full w-full object-cover object-center"
                loading="eager"
              />
            </div>

            <!-- 4. Arco derecho con retrato 2 (esquina superior izquierda e inferior derecha redondeadas, superpuesto) -->
            <div class="absolute top-[23%] right-[6%] z-10 h-[62%] w-[51%] overflow-hidden rounded-tl-[135px] rounded-br-[135px] border-l-4 border-vellum-sheet bg-easton-blue-200 shadow-xs">
              <img
                src={rightPortrait}
                alt="Retrato derecho"
                class="h-full w-full object-cover object-center"
                loading="eager"
              />
            </div>

            <!-- 5. Semicírculo derecho externo (Mashle Red) -->
            <div
              aria-hidden="true"
              class="absolute top-[23%] right-[-4%] h-[18.5%] w-[9.5%] rounded-r-full bg-mashle-red-500"
            ></div>

            <!-- 6. Cuadrado medio izquierdo (Easton Blue) -->
            <div
              aria-hidden="true"
              class="absolute top-[69%] left-[12%] aspect-square w-[21.5%] bg-easton-blue-600"
            ></div>

            <!-- 7. Semicírculo inferior izquierdo (Wand Brown / Easton) -->
            <div
              aria-hidden="true"
              class="absolute top-[80%] left-[12%] h-[10.5%] w-[21.5%] rounded-t-full bg-wand-brown-500"
            ></div>

            <!-- 8. Bloque inferior central amarillo con semicírculo oscuro interior -->
            <div
              aria-hidden="true"
              class="absolute bottom-0 left-[38%] flex h-[15%] w-[46%] items-end justify-center overflow-hidden bg-lunar-yellow-500"
            >
              <div class="h-[88%] w-[76%] rounded-t-full bg-easton-blue-500"></div>
            </div>

            <!-- 9. Círculo inferior derecho (Wand Brown) -->
            <div
              aria-hidden="true"
              class="absolute right-[-4%] bottom-0 aspect-square w-[18.5%] rounded-full bg-wand-brown-600"
            ></div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
