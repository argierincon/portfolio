---
import Layout from "../layouts/Layout.astro";
import StatCard from "../components/StatCard.astro";
import Chip from "../components/Chip.astro";
---

<Layout>
	<div class="mx-auto max-w-7xl space-y-12 my-10 border-b border-easton-blue-200 pb-6">
		<!-- ENCABEZADOS H1 - H6 -->
		<section class="space-y-6">
			<header class="mb-10">
				<span class="inline-block rounded bg-lunar-yellow-100 px-3 py-1 font-mono text-xs font-semibold text-easton-blue-500">
					Headers · Cinzel
				</span>
				<h1 class="mt-3 font-display text-3xl font-bold text-mashle-red-500">
					Muestrario de Encabezados
				</h1>
			</header>

			<div class="space-y-6 rounded-2xl border border-easton-blue-200 bg-vellum-sheet p-6">
				<div class="border-b border-easton-blue-100 pb-5">
					<span class="caption text-wand-brown-500">
						H1 · 900 · Mobile 36px / Desktop 54px · LH 1.2
					</span>
					<h1 class="mt-1 text-easton-blue-500">Encabezado H1 Principal</h1>
				</div>

				<div class="border-b border-easton-blue-100 pb-5">
					<span class="caption text-wand-brown-500">
						H2 · 900 · Mobile 32px / Desktop 48px · LH 1.2
					</span>
					<h2 class="mt-1 text-easton-blue-500">Encabezado H2 de Sección</h2>
				</div>

				<div class="border-b border-easton-blue-100 pb-5">
					<span class="caption text-wand-brown-500">
						H3 · 700 · Mobile 28px / Desktop 38px · LH 1.3
					</span>
					<h3 class="mt-1 text-easton-blue-500">Encabezado H3 Subtítulo</h3>
				</div>

				<div class="border-b border-easton-blue-100 pb-5">
					<span class="caption text-wand-brown-500">
						H4 · 700 · Mobile 24px / Desktop 28px · LH 1.3
					</span>
					<h4 class="mt-1 text-easton-blue-500">Encabezado H4 Tarjeta</h4>
				</div>

				<div class="border-b border-easton-blue-100 pb-5">
					<span class="caption text-wand-brown-500">
						H5 · 700 · Mobile 18px / Desktop 20px · LH 1.3
					</span>
					<h5 class="mt-1 text-easton-blue-500">Encabezado H5 Menor</h5>
				</div>

				<div>
					<span class="caption text-wand-brown-500">
						H6 · 400 · Mobile 16px / Desktop 18px · LH 1.3
					</span>
					<h6 class="mt-1 text-easton-blue-500">Encabezado H6 Etiqueta</h6>
				</div>
			</div>
		</section>

		<!-- SUBTÍTULOS Y TEXTO -->
		<section class="space-y-6">
			<header class="mb-10">
				<span class="inline-block rounded bg-lunar-yellow-100 px-3 py-1 font-mono text-xs font-semibold text-easton-blue-500">
					Typography Utilities · Plus Jakarta Sans
				</span>
				<h2 class="mt-3 font-display text-3xl font-bold text-mashle-red-500">
					Muestrario de Subtítulos y Texto
				</h2>
			</header>

			<div class="grid gap-6 rounded-2xl border border-easton-blue-200 bg-vellum-sheet p-6 md:grid-cols-2">
				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="caption text-wand-brown-500">
						.subtitle-1 · 700 · Mobile 14px (0.875rem) / Desktop 16px (1rem) ·
						LH 1.5
					</span>
					<p class="subtitle-1 text-easton-blue-500">
						Texto de subtítulo principal para destacar bloques o resúmenes.
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="caption text-wand-brown-500">
						.subtitle-2 · 600 · Mobile 14px (0.875rem) / Desktop 16px (1rem) ·
						LH 1.5
					</span>
					<p class="subtitle-2 text-easton-blue-500">
						Texto de subtítulo secundario para destacar bloques o resúmenes.
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="caption text-wand-brown-500">
						.subtitle-3 · 600 · Mobile 12px (0.75rem) / Desktop 14px (0.875rem)
						· LH 1.5
					</span>
					<p class="subtitle-3 text-easton-blue-500">
						Texto de subtítulo terciario para encabezados de apoyo o metadatos.
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="caption text-wand-brown-500">
						.body-1 · 400 · Mobile 14px (0.875rem) / Desktop 16px (1rem) · LH
						1.5
					</span>
					<p class="body-1 text-obsidian-ink">
						Párrafo principal de lectura cómoda con interlineado 1.5 y buen
						contraste sobre fondo claro.
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="caption text-wand-brown-500">
						.body-2 · 400 · Mobile 12px (0.75rem) / Desktop 14px (0.875rem) · LH
						1.5
					</span>
					<p class="body-2 text-obsidian-ink">
						Texto secundario para descripciones compactas, tarjetas o notas
						complementarias.
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="caption text-wand-brown-500">
						.text-button · 600 · Mobile 14px (0.875rem) / Desktop 16px (1rem) ·
						LH 1.5
					</span>
					<p class="text-button text-mashle-red-500">
						Etiqueta tipográfica para acciones y botones
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="caption text-wand-brown-500">
						.caption · 400 · Mobile 10px (0.625rem) / Desktop 12px (0.75rem) ·
						LH 1.5
					</span>
					<p class="caption text-wand-brown-500">
						Nota al pie, aclaración o dato auxiliar de tamaño reducido.
					</p>
				</div>

				<div class="space-y-1 md:col-span-2">
					<span class="caption text-wand-brown-500">
						.overline · 500 · 10px (0.625rem) · LH 1.5
					</span>
					<p class="overline text-easton-blue-500">
						Antetítulo o categoría superior en mayúsculas
					</p>
				</div>
			</div>
		</section>

		<!-- SUBTÍTULOS Y TEXTO · JETBRAINS MONO -->
		<section class="space-y-6">
			<header class="mb-10">
				<span class="inline-block rounded bg-lunar-yellow-100 px-3 py-1 font-mono text-xs font-semibold text-easton-blue-500">
					Typography Utilities · JetBrains Mono
				</span>
				<h2 class="mt-3 font-display text-3xl font-bold text-mashle-red-500">
					Muestrario de Subtítulos y Texto (Mono)
				</h2>
			</header>

			<div class="grid gap-6 rounded-2xl border border-easton-blue-200 bg-vellum-sheet p-6 md:grid-cols-2">
				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="mono-caption text-wand-brown-500">
						.mono-subtitle-1 · 700 · Mobile 14px (0.875rem) / Desktop 16px
						(1rem) · LH 1.5
					</span>
					<p class="mono-subtitle-1 text-easton-blue-500">
						const moduleName = "HexagonalArchitecture";
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="mono-caption text-wand-brown-500">
						.mono-subtitle-2 · 600 · Mobile 14px (0.875rem) / Desktop 16px
						(1rem) · LH 1.5
					</span>
					<p class="mono-subtitle-2 text-easton-blue-500">
						GET /api/v1/products · 200 OK
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="mono-caption text-wand-brown-500">
						.mono-subtitle-3 · 600 · Mobile 12px (0.75rem) / Desktop 14px
						(0.875rem) · LH 1.5
					</span>
					<p class="mono-subtitle-3 text-easton-blue-500">
						spring.profiles.active=dev
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="mono-caption text-wand-brown-500">
						.mono-body-1 · 400 · Mobile 14px (0.875rem) / Desktop 16px (1rem) ·
						LH 1.5
					</span>
					<p class="mono-body-1 text-obsidian-ink">
						// Bloque de código o salida técnica con interlineado 1.5
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="mono-caption text-wand-brown-500">
						.mono-body-2 · 400 · Mobile 12px (0.75rem) / Desktop 14px (0.875rem)
						· LH 1.5
					</span>
					<p class="mono-body-2 text-obsidian-ink">
						docker compose up -d --build
					</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="mono-caption text-wand-brown-500">
						.mono-text-button · 600 · Mobile 14px (0.875rem) / Desktop 16px
						(1rem) · LH 1.5
					</span>
					<p class="mono-text-button text-mashle-red-500">[ RUN_TESTS ]</p>
				</div>

				<div class="space-y-1 border-b border-easton-blue-100 pb-4">
					<span class="mono-caption text-wand-brown-500">
						.mono-caption · 400 · Mobile 10px (0.625rem) / Desktop 12px
						(0.75rem) · LH 1.5
					</span>
					<p class="mono-caption text-wand-brown-500">v2.4.0 · build #1084</p>
				</div>

				<div class="space-y-1 md:col-span-2">
					<span class="mono-caption text-wand-brown-500">
						.mono-overline · 500 · 10px (0.625rem) · LH 1.5
					</span>
					<p class="mono-overline text-easton-blue-500">
						SYSTEM TELEMETRY · TERMINAL OUTPUT
					</p>
				</div>
			</div>
		</section>
	</div>

	<div class="mx-auto max-w-7xl space-y-4 my-10 border-b border-easton-blue-200 pb-6">
		<header class="mb-10">
			<span class="inline-block rounded bg-lunar-yellow-100 px-3 py-1 font-mono text-xs font-semibold text-easton-blue-500">
				CHIPS
			</span>
			<h1 class="mt-3 font-display text-3xl font-bold text-mashle-red-500">
				Muestrario de Chips
			</h1>
			<p class="mt-2 font-sans text-base text-easton-blue-500">
				Pasa el cursor y mantén presionado en cada chip para verificar estados
				<span class="font-mono text-sm">hover</span> y
				<span class="font-mono text-sm">active</span>.
			</p>
		</header>

		<!-- Variante 1 · .mono-body-2 -->
		<div class="space-y-4">
			<div class="mb-2">
				<span class="mono-overline text-wand-brown-500">
					Variante 1 · .mono-body-2
				</span>
			</div>

			<div class="flex flex-wrap items-center gap-3">
				<Chip size="md" appearance="soft" color="mashle-red">
					Java
				</Chip>
				<Chip size="md" appearance="soft" color="easton-blue">
					React
				</Chip>
				<Chip size="md" appearance="soft" color="wand-brown">
					MySQL
				</Chip>
				<Chip size="md" appearance="soft" color="lunar-yellow">
					TypeScript
				</Chip>
			</div>

			<div class="flex flex-wrap items-center gap-3">
				<Chip size="md" appearance="solid" color="mashle-red">
					Java
				</Chip>
				<Chip size="md" appearance="solid" color="easton-blue">
					React
				</Chip>
				<Chip size="md" appearance="solid" color="wand-brown">
					MySQL
				</Chip>
				<Chip size="md" appearance="solid" color="lunar-yellow">
					TypeScript
				</Chip>
			</div>
		</div>

		<!-- Variante 2 · .mono-caption -->
		<div class="mt-8 space-y-4">
			<div class="mb-2">
				<span class="mono-overline text-wand-brown-500">
					Variante 2 · .mono-caption
				</span>
			</div>

			<div class="flex flex-wrap items-center gap-3">
				<Chip size="sm" appearance="soft" color="mashle-red">
					Java
				</Chip>
				<Chip size="sm" appearance="soft" color="easton-blue">
					React
				</Chip>
				<Chip size="sm" appearance="soft" color="wand-brown">
					MySQL
				</Chip>
				<Chip size="sm" appearance="soft" color="lunar-yellow">
					TypeScript
				</Chip>
			</div>

			<div class="flex flex-wrap items-center gap-3">
				<Chip size="sm" appearance="solid" color="mashle-red">
					Java
				</Chip>
				<Chip size="sm" appearance="solid" color="easton-blue">
					React
				</Chip>
				<Chip size="sm" appearance="solid" color="wand-brown">
					MySQL
				</Chip>
				<Chip size="sm" appearance="solid" color="lunar-yellow">
					TypeScript
				</Chip>
			</div>
		</div>
	</div>

	<div class="mx-auto max-w-7xl space-y-4 my-10 border-b border-easton-blue-200 pb-6">
		<header class="mb-10">
			<span class="inline-block rounded bg-lunar-yellow-100 px-3 py-1 font-mono text-xs font-semibold text-easton-blue-500">
				BUTTON STATES · 500 / 600 / 700
			</span>
			<h1 class="mt-3 font-display text-3xl font-bold text-mashle-red-500">
				Muestrario de Botones
			</h1>
			<p class="mt-2 font-sans text-base text-easton-blue-500">
				Pasa el cursor (<span class="font-mono text-sm">hover:600</span>) y haz
				clic mantenido (<span class="font-mono text-sm">active:700</span>) en
				cada botón.
			</p>
		</header>

		<!-- BOTONES FILLED -->
		<div>
			<div class="mb-2">
				<span class="mono-overline text-wand-brown-500">
					Variante 1 · Filled
				</span>
			</div>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				<!-- 1. MASHLE RED -->
				<article class="flex flex-col justify-between rounded-2xl border border-easton-blue-200 bg-vellum-sheet p-6 shadow-sm">
					<div class="space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="font-display text-lg font-bold text-easton-blue-500">
								Mashle Red
							</h2>
							<span class="font-mono text-xs text-wand-brown-500">500</span>
						</div>

						<!-- Botón interactivo -->
						<button
							type="button"
							class="text-button w-full cursor-pointer whitespace-nowrap rounded-md bg-mashle-red-500 px-4 py-2.5 text-chalk-paper transition-colors duration-150 hover:bg-mashle-red-600 active:bg-mashle-red-700"
						>
							Acción Mashle Red
						</button>

						<!-- Referencia visual de estados -->
						<div class="space-y-2 border-t border-easton-blue-100 pt-4 font-mono text-xs">
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Normal (500)</span>
								<span class="shrink-0 rounded bg-mashle-red-500 px-2 py-0.5 text-chalk-paper">
									#C51E25
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Hover (600)</span>
								<span class="shrink-0 rounded bg-mashle-red-600 px-2 py-0.5 text-chalk-paper">
									#D7333F
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Active (700)</span>
								<span class="shrink-0 rounded bg-mashle-red-700 px-2 py-0.5 text-chalk-paper">
									#780000
								</span>
							</div>
						</div>
					</div>

					<p class="mt-5 break-words font-mono text-[11px] text-easton-blue-600">
						bg-mashle-red-500 hover:bg-mashle-red-600 active:bg-mashle-red-700
					</p>
				</article>

				<!-- 2. EASTON BLUE -->
				<article class="flex flex-col justify-between rounded-2xl border border-easton-blue-200 bg-vellum-sheet p-6 shadow-sm">
					<div class="space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="font-display text-lg font-bold text-easton-blue-500">
								Easton Blue
							</h2>
							<span class="font-mono text-xs text-wand-brown-500">500</span>
						</div>

						<!-- Botón interactivo -->
						<button
							type="button"
							class="text-button w-full cursor-pointer whitespace-nowrap rounded-md bg-easton-blue-500 px-4 py-2.5 text-chalk-paper transition-colors duration-150 hover:bg-easton-blue-600 active:bg-easton-blue-700"
						>
							Acción Easton Blue
						</button>

						<!-- Referencia visual de estados -->
						<div class="space-y-2 border-t border-easton-blue-100 pt-4 font-mono text-xs">
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Normal (500)</span>
								<span class="shrink-0 rounded bg-easton-blue-500 px-2 py-0.5 text-chalk-paper">
									#0F1E36
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Hover (600)</span>
								<span class="shrink-0 rounded bg-easton-blue-600 px-2 py-0.5 text-chalk-paper">
									#1C3D7A
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Active (700)</span>
								<span class="shrink-0 rounded bg-easton-blue-700 px-2 py-0.5 text-chalk-paper">
									#1F3A60
								</span>
							</div>
						</div>
					</div>

					<p class="mt-5 break-words font-mono text-[11px] text-easton-blue-600">
						bg-easton-blue-500 hover:bg-easton-blue-600
						active:bg-easton-blue-700
					</p>
				</article>

				<!-- 3. WAND BROWN -->
				<article class="flex flex-col justify-between rounded-2xl border border-easton-blue-200 bg-vellum-sheet p-6 shadow-sm">
					<div class="space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="font-display text-lg font-bold text-easton-blue-500">
								Wand Brown
							</h2>
							<span class="font-mono text-xs text-wand-brown-500">500</span>
						</div>

						<!-- Botón interactivo -->
						<button
							type="button"
							class="text-button w-full cursor-pointer whitespace-nowrap rounded-md bg-wand-brown-500 px-4 py-2.5 text-chalk-paper transition-colors duration-150 hover:bg-wand-brown-600 active:bg-wand-brown-700"
						>
							Acción Wand Brown
						</button>

						<!-- Referencia visual de estados -->
						<div class="space-y-2 border-t border-easton-blue-100 pt-4 font-mono text-xs">
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Normal (500)</span>
								<span class="shrink-0 rounded bg-wand-brown-500 px-2 py-0.5 text-chalk-paper">
									#8C5230
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Hover (600)</span>
								<span class="shrink-0 rounded bg-wand-brown-600 px-2 py-0.5 text-chalk-paper">
									#AF5C2C
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Active (700)</span>
								<span class="shrink-0 rounded bg-wand-brown-700 px-2 py-0.5 text-chalk-paper">
									#6F3506
								</span>
							</div>
						</div>
					</div>

					<p class="mt-5 break-words font-mono text-[11px] text-easton-blue-600">
						bg-wand-brown-500 hover:bg-wand-brown-600 active:bg-wand-brown-700
					</p>
				</article>

				<!-- 4. LUNAR YELLOW -->
				<article class="flex flex-col justify-between rounded-2xl border border-easton-blue-200 bg-vellum-sheet p-6 shadow-sm">
					<div class="space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="font-display text-lg font-bold text-easton-blue-500">
								Lunar Yellow
							</h2>
							<span class="font-mono text-xs text-wand-brown-500">500</span>
						</div>

						<!-- Botón interactivo -->
						<button
							type="button"
							class="text-button w-full cursor-pointer whitespace-nowrap rounded-md bg-lunar-yellow-500 px-4 py-2.5 text-easton-blue-500 transition-colors duration-150 hover:bg-lunar-yellow-600 active:bg-lunar-yellow-700"
						>
							Acción Lunar Yellow
						</button>

						<!-- Referencia visual de estados -->
						<div class="space-y-2 border-t border-easton-blue-100 pt-4 font-mono text-xs">
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Normal (500)</span>
								<span class="shrink-0 rounded bg-lunar-yellow-500 px-2 py-0.5 text-easton-blue-500">
									#FBDE74
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Hover (600)</span>
								<span class="shrink-0 rounded bg-lunar-yellow-600 px-2 py-0.5 text-easton-blue-500">
									#F9E69F
								</span>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-wand-brown-500">Active (700)</span>
								<span class="shrink-0 rounded bg-lunar-yellow-700 px-2 py-0.5 text-easton-blue-500">
									#ECC022
								</span>
							</div>
						</div>
					</div>

