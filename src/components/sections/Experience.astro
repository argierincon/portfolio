---
import ExperienceCard from "../ExperienceCard.astro";
import EastonChip from "../EastonChip.astro";
import ActionButton from "../ActionButton.astro";

type AccentColor = "lunar-yellow" | "mashle-red" | "easton-blue" | "wand-brown";

interface TimelineEntry {
  side: "left" | "right";
  year: string;
  milestone: string;
  period: string;
  role: string;
  company: string;
  domain?: string;
  description: string;
  tags: readonly string[];
  accentColor?: AccentColor;
}

const timeline: readonly TimelineEntry[] = [
  {
    side: "left",
    year: "2025",
    milestone: "Modelo de suscripción y accesos",
    period: "FEBRERO 2025 — MARZO 2025",
    role: "Full Stack Developer",
    company: "Rumbo",
    domain: "Lima, Perú · eCommerce / Coworking",
    description:
      "Construí y evolucioné funcionalidades clave de la plataforma e-commerce en Next.js, TypeScript y Tailwind. Desarrollé una landing page de 8 secciones interactivas, conectando interfaz, lógica de negocio y backend. Implementé autenticación con Auth0, middlewares protegidos y redirección por roles, refactoricé el simulador de compra (cálculo de precios, IGV y prorrateo), reforcé el flujo con la pasarela de pagos y la sincronización de suscripciones vía API con Zustand y Axios, y creé vistas administrativas con reportes en CSV.",
    tags: ["Next.js", "TypeScript", "Auth0", "Zustand", "REST APIs"],
    accentColor: "lunar-yellow",
  },
  {
    side: "right",
    year: "2024",
    milestone: "Operación omnicanal en vivo",
    period: "DICIEMBRE 2023 — ABRIL 2024",
    role: "Frontend Developer",
    company: "Securitec",
    domain: "Contrato Temporal · Contact Center",
    description:
      "Contribuí a modernizar el núcleo frontend de su plataforma de contact center omnicanal para gestionar operaciones de voz y mensajería en tiempo real. Evolucioné módulos con código heredado migrando componentes de Vue 2 a Vue 3, gestionando estado con Vuex y Pinia e integrando APIs REST en Python. Refactoricé el Workspace de agentes hacia el nuevo diseño, amplié la personalización del WebChat (marca, colores, horarios y avatares) y desarrollé nuevos nodos de configuración para el IVR (los flujos de respuesta automática por voz/menús telefónicos).",
    tags: ["Vue 3", "TypeScript", "Pinia", "Vuex", "SASS", "REST API"],
    accentColor: "lunar-yellow",
  },
  {
    side: "left",
    year: "2023",
    milestone: "Estandarización y reutilización",
    period: "DICIEMBRE 2022 — JUNIO 2023",
    role: "Frontend Developer",
    company: "Lúcuma Labs",
    domain: "Lima, Perú · JSON-Driven UI",
    description:
      "Participé en el desarrollo frontend para UPC en 4 proyectos distintos: convalidación de carreras, comparador de carreras, quiz vocacional y un gestor de landings interactivas con 7 tipos de landing pages. Construí el gestor de landings bajo una arquitectura JSON-driven en Nuxt 3, Vue y TypeScript con +47 componentes reutilizables, formularios dinámicos validados con VeeValidate y Yup para cada tipo de página y 9 módulos de Pinia, consolidados en un store unificado. Además, conduje entrevistas técnicas y asumí el liderazgo de 2 nuevas incorporaciones al equipo.",
    tags: [
      "Vue.js",
      "Nuxt 3",
      "TypeScript",
      "Pinia",
      "VeeValidate",
      "SendGrid",
    ],
    accentColor: "lunar-yellow",
  },
  {
    side: "right",
    year: "2021 — 2022",
    milestone: "Evolución hacia SaaS escalable",
    period: "MARZO 2021 — SEPTIEMBRE 2022",
    role: "Full Stack Developer",
    company: "Blooz",
    domain: "Lima, Perú · Logística Última Milla",
    description:
      "Impulsé la evolución de una plataforma de logística y micrologística desde un sistema tradicional hacia un entorno SaaS multi-tenant, abarcando frontend, backend y procesos de equipo. Desarrollé componentes reutilizables en Vue y Nuxt con Vuex (incluyendo calculadora de envíos, calificación de repartidores e integración con Google Maps), construí un microservicio en Node.js y Express.js conectado al API de WhatsApp para notificaciones automáticas de pedidos, diseñé prototipos móviles en Figma y desplegué en AWS CloudFront, además de impulsar Scrum, Git Flow, Jira/Confluence, Slack, code reviews, coordinación con un equipo extranjero y entrevistas técnicas para Frontend Developer y Sales Executive.",
    tags: [
      "Vue",
      "Nuxt",
      "Vuex",
      "Node.js",
      "Google Maps API",
      "AWS CloudFront",
    ],
    accentColor: "lunar-yellow",
  },
];
---

<section id="experiencias" class="container-sections space-y-12">
  <div class="max-w-xl space-y-6">
    <h2 class="title-sections">Experiencia</h2>
    <p class="body-1">
      Cada etapa ha sumado orden, criterio técnico y enfoque en el negocio para
      convertir procesos complejos en software útil.
    </p>
  </div>
  <div class="relative">
    <!-- Línea vertical: alineada desde el inicio de la primera tarjeta hasta el final de la última -->
    <div
      class="pointer-events-none absolute left-3.5 top-0 bottom-0 w-0.5 -translate-x-1/2 bg-wand-brown-500/70 lg:left-1/2 lg:bottom-[-8px]"
      aria-hidden="true"
    />

    <div class="space-y-12">
      {timeline.map((item) => {
        const isLeft = item.side === "left";

        return (
          <div class="relative grid grid-cols-[1.75rem_1fr] items-start gap-1 lg:grid-cols-[1fr_3rem_1fr] lg:items-center lg:gap-8">
            <!-- Nodo en MOBILE (alineado a la línea izquierda) -->
            <div
              class="flex h-10 w-7 shrink-0 items-center justify-center lg:hidden"
              aria-hidden="true"
            >
              <svg
                class="relative z-10 h-10 w-10 shrink-0 text-wand-brown-500"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z"
                  class="stroke-chalk-paper"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <!-- Columna izquierda en desktop (y bloque principal en mobile) -->
            <div
              class={
                !isLeft
                  ? "flex flex-col items-start gap-3 lg:flex lg:flex-col lg:items-end lg:px-4 lg:text-right"
                  : "lg:px-4"
              }
            >
              {isLeft ? (
                <div class="flex flex-col gap-6 lg:block">
                  <!-- Año + hito en mobile encima de la card -->
                  <div class="flex flex-col items-start gap-2.5 lg:hidden">
                    <span class="font-display text-4xl font-bold leading-none tracking-tight text-easton-blue-500">
                      {item.year}
                    </span>
                    <EastonChip
                      size="md"
                      variant="solid"
                      style="outlined"
                      color="wand-brown"
                      case="normal"
                      weight="regular"
                      class="bg-vellum-sheet"
                    >
                      {item.milestone}
                    </EastonChip>
                  </div>

                  <ExperienceCard
                    period={item.period}
                    role={item.role}
                    company={item.company}
                    domain={item.domain}
                    description={item.description}
                    tags={item.tags}
                    accentColor={item.accentColor}
                  />
                </div>
              ) : (
                <>
                  <!-- En mobile: año arriba, luego card, luego hito -->
                  <div class="flex flex-col items-start gap-2.5 lg:hidden">
                    <span class="font-display text-4xl font-bold leading-none tracking-tight text-easton-blue-500">
                      {item.year}
                    </span>
                    <EastonChip
                      size="md"
                      variant="solid"
                      style="outlined"
                      color="wand-brown"
                      case="normal"
                      weight="regular"
                      class="bg-vellum-sheet"
                    >
                      {item.milestone}
                    </EastonChip>
                  </div>

                  <div class="w-full lg:hidden">
                    <ExperienceCard
                      period={item.period}
                      role={item.role}
                      company={item.company}
                      domain={item.domain}
                      description={item.description}
                      tags={item.tags}
                      accentColor={item.accentColor}
                    />
                  </div>

                  <!-- En desktop: año + chip -->
                  <span class="hidden font-display text-5xl font-bold tracking-tight text-easton-blue-500 lg:block">
                    {item.year}
                  </span>

                  <div class="hidden lg:block">
                    <EastonChip
                      size="md"
                      variant="solid"
                      style="outlined"
                      color="wand-brown"
                      case="normal"
                      weight="regular"
                      class="bg-vellum-sheet"
                    >
                      {item.milestone}
                    </EastonChip>
                  </div>
                </>
              )}
            </div>

            <!-- Nodo central en desktop -->
            <div
              class="relative z-10 hidden items-center justify-center lg:flex"
              aria-hidden="true"
            >
              <svg
                class="h-16 w-16 text-wand-brown-500"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z"
                  class="stroke-chalk-paper"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <!-- Columna derecha en desktop (solo visible en lg+ cuando side="left") -->
            <div
              class={
                isLeft
                  ? "hidden lg:flex lg:flex-col lg:items-start lg:gap-3 lg:px-4 lg:text-left"
                  : "hidden lg:block lg:px-4"
              }
            >
              {isLeft ? (
                <>
                  <span class="font-display text-5xl font-bold tracking-tight text-easton-blue-500">
                    {item.year}
                  </span>

                  <EastonChip
                    size="md"
                    variant="solid"
                    style="outlined"
                    color="wand-brown"
                    case="normal"
                    weight="regular"
                    class="bg-vellum-sheet"
                  >
                    {item.milestone}
                  </EastonChip>
                </>
              ) : (
                <ExperienceCard
                  period={item.period}
                  role={item.role}
                  company={item.company}
                  domain={item.domain}
                  description={item.description}
                  tags={item.tags}
                  accentColor={item.accentColor}
                />
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
  <div class="mx-auto mt-16 w-fit flex flex-col items-center gap-6">
    <h3 class="text-easton-blue-500">¿Siguiente Reto?</h3>

    <div class="flex flex-wrap items-center gap-6">
      <ActionButton
        variant="filled"
        color="mashle-red"
        class="w-full sm:w-auto"
      >
        Contáctame
      </ActionButton>

      <ActionButton
        variant="outlined"
        color="easton-blue"
        class="w-full sm:w-auto"
      >
        Descargar CV
      </ActionButton>
    </div>
  </div>
</section>
