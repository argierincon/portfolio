---
import ActionButton from "../ActionButton.astro";
---

<!-- w-full max-w-6xl md:px-8 xl:p-0 -->
<section class="overflow-x-clip pt-14 md:pt-20 lg:pt-[6rem] xl:pt-[8rem] grid items-center lg:grid-cols-12 mx-auto sm:px-6 max-w-6xl xl:px-0">
  <div class="space-y-6 lg:col-span-6 px-6 sm:px-0 mx-auto">
    <!-- Bloque encabezado: eyebrow + H1 -->
    <div class="space-y-6">
      <div class="flex items-center gap-1 text-mashle-red-500">
        <!-- Triángulo izquierdo apuntando hacia adentro -->
        <svg
          class="h-3.5 w-2.5 shrink-0 text-mashle-red-500"
          viewBox="0 0 20 28"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="0,0 20,14 0,28" />
        </svg>

        <h4>Argie Rincón</h4>

        <!-- Triángulo derecho apuntando hacia adentro -->
        <svg
          class="h-3.5 w-2.5 shrink-0 text-mashle-red-500"
          viewBox="0 0 20 28"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="20,0 0,14 20,28" />
        </svg>
      </div>

      <h1 class="uppercase text-easton-blue-500">Full Stack Java Developer</h1>
    </div>

    <!-- Párrafos -->
    <div class="max-w-xl grid gap-1.5">
      <p class="body-1">
        Sin atajos ni trucos mágicos: construyo software sólido a base de
        disciplina, arquitectura limpia y ejecución constante.
      </p>
      <p class="body-1">
        De procesos industriales a doble jornada intensiva de código: desarrollo
        aplicaciones web enfocadas en orden, escalabilidad y resolución práctica
        de problemas.
      </p>
    </div>

    <!-- Botones -->
    <div class="flex flex-wrap items-center gap-6">
      <ActionButton
        variant="filled"
        color="mashle-red"
        class="w-full sm:w-auto"
      >
        Ver Proyectos
      </ActionButton>

      <ActionButton
        variant="outlined"
        color="wand-brown"
        class="w-full sm:w-auto"
      >
        Contáctame
      </ActionButton>
    </div>
  </div>

  <!-- Columna derecha -->
  <div class="relative mt-12 lg:col-span-6 lg:mt-0 overflow-hidden">
    <div class="relative sm:mx-auto w-full max-w-xl py-[75px] sm:py-[7rem] sm:pr-16">
      <!-- Figuras geométricas de fondo -->
      <div class="pointer-events-none select-none" aria-hidden="true">
        <!-- ARRIBA -->
        <!-- Rectángulo marron arriba a la izquierda -->
        <div class="absolute -left-4 top-3 sm:top-4 h-16 w-28 bg-wand-brown-500 sm:left-0 sm:h-24 sm:w-48" />

        <!-- Círculo amarillo arriba -->
        <div class="absolute left-24 top-3 sm:top-4 h-16 w-16 rounded-full bg-lunar-yellow-500 sm:left-48 sm:h-24 sm:w-24" />
        <div></div>

        <!-- DERECHA -->
        <!-- Círculo rojo a la derecha -->
        <div class="absolute right-[4%] top-44 h-20 w-20 rounded-full bg-mashle-red-500 sm:right-0 sm:top-1/3 sm:h-40 sm:w-40" />

        <!-- ABAJO -->
        <!-- Rectángulo rojo abajo a la izquierda -->
        <div class="absolute -left-4 bottom-4 h-16 w-20 bg-mashle-red-500 sm:bottom-4 sm:left-0 sm:h-24 sm:w-32" />

        <!-- 2 ... Rectángulo amarillo abajo al centro con Semicírculo azul oscuro -->
        <div class="absolute bottom-0 left-[40%] sm:left-1/3 sm:translate-x-0">
          <!-- El rectángulo amarillo ES el contenedor relativo con tamaño real -->
          <div class="relative h-[4.7rem] w-32 overflow-hidden bg-lunar-yellow-500 sm:h-32 sm:w-60">
            <!-- Semicírculo azul oscuro centrado respecto al rectángulo amarillo -->
            <div class="absolute -bottom-10 left-1/2 h-20 w-20 -translate-x-1/2 rounded-full bg-easton-blue-500 sm:-bottom-20 sm:h-40 sm:w-40" />
          </div>
        </div>

        <!-- Círculo marrón abajo a la derecha -->
        <div class="absolute right-0 bottom-0 h-14 w-14 rounded-full bg-wand-brown-500 sm:bottom-2 sm:right-0 sm:h-24 sm:w-24" />
      </div>

      <!-- Ventana de código -->
      <div class="relative z-10 w-[85%] sm:w-full overflow-hidden rounded-r-2xl rounded-l-none border border-easton-blue-500 bg-[#14171c] text-chalk-paper">
        <!-- Barra superior tipo ventana -->
        <div class="flex items-center gap-4 border-b border-chalk-paper/10 bg-[#1a1e24] px-4 py-3">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-[#ff5f56]" />
            <span class="h-3 w-3 rounded-full bg-[#ffbd2e]" />
            <span class="h-3 w-3 rounded-full bg-[#27c93f]" />
          </div>
          <span class="font-mono text-xs text-chalk-paper/60">
            developer.js
          </span>
        </div>

        <!-- Cuerpo de código -->
        <pre class="overflow-x-auto p-5 font-mono text-xs leading-relaxed sm:p-6 sm:text-[13px]"><code><span class="text-[#c792ea]">const</span> <span class="text-[#82aaff]">developer</span> <span class="text-[#89ddff]">=</span> <span class="text-[#89ddff]">{`{`}</span>
  <span class="text-[#f07178]">name</span><span class="text-[#89ddff]">:</span> <span class="text-[#c3e88d]">"Argie Rincón"</span><span class="text-[#89ddff]">,</span>
  <span class="text-[#f07178]">role</span><span class="text-[#89ddff]">:</span> <span class="text-[#c3e88d]">"Full Stack Java Developer"</span><span class="text-[#89ddff]">,</span>
  <span class="text-[#f07178]">architecture</span><span class="text-[#89ddff]">:</span> <span class="text-[#c3e88d]">"Clean Architecture · REST APIs"</span><span class="text-[#89ddff]">,</span>
  <span class="text-[#f07178]">stack</span><span class="text-[#89ddff]">:</span> <span class="text-[#89ddff]">[</span>
    <span class="text-[#c3e88d]">"Java 25"</span><span class="text-[#89ddff]">,</span> <span class="text-[#c3e88d]">"Spring Boot"</span><span class="text-[#89ddff]">,</span> <span class="text-[#c3e88d]">"PostgreSQL"</span><span class="text-[#89ddff]">,</span> <span class="text-[#c3e88d]">"MySQL"</span><span class="text-[#89ddff]">,</span>
    <span class="text-[#c3e88d]">"React"</span><span class="text-[#89ddff]">,</span> <span class="text-[#c3e88d]">"TypeScript"</span><span class="text-[#89ddff]">,</span> <span class="text-[#c3e88d]">"Docker"</span><span class="text-[#89ddff]">,</span> <span class="text-[#c3e88d]">"Kafka"</span>
  <span class="text-[#89ddff]">],</span>
  <span class="text-[#f07178]">openToWork</span><span class="text-[#89ddff]">:</span> <span class="text-[#ff9cac]">true</span>
<span class="text-[#89ddff]">{`}`}</span><span class="text-[#89ddff]">;</span></code></pre>
      </div>
    </div>
  </div>
</section>
