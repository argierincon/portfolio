---
interface EducationItem {
  period: string;
  title: string;
  subtitle: string;
  badge: string;
  description?: string;
}

import Chip from "../Chip.astro";

const items: readonly EducationItem[] = [
  {
    period: "Jul 2026 – Ene 2027",
    title: "Programa de Desarrollo web Full Stack con Java",
    subtitle: "CodiGo Tecsup, Lima, Perú",
    badge: "Java · Spring Boot",
    description:
      "Fundamentos del lenguaje, POO, colecciones y manejo de excepciones.",
  },
  {
    period: "Sep 2026 – Dic 2026",
    title: "Programa de Desarrollador Full Stack Java",
    subtitle: "Generation Colombia, Lima, Perú",
    badge: "Java · Spring Boot",
    description:
      "Formación intensiva en desarrollo backend, APIs REST y frontend.",
  },
  {
    period: "Abril, 2026",
    title: "Fundamentos y Modelamiento de Datos con SQL (SQL Server)",
    subtitle: "",
    badge: "",
  },
  {
    period: "Octubre, 2023",
    title: "Curso Intermedio de Programación Orientada a Objetos en JavaScript",
    subtitle: "",
    badge: "",
  },
  {
    period: "Feb 2020 – Sep 2020",
    title: "Especialización en Desarrollo Web Frontend",
    subtitle: "Laboratoria, Lima, Perú",
    badge: "Java · Spring Boot",
    description:
      "Diseño de servicios desacoplados, configuración y buenas prácticas.",
  },
];
---

<section id="formacion" class="container-sections space-y-6">
  <!-- Encabezado de sección -->
  <div class="max-w-2xl space-y-6">
    <h2 class="title-sections">Formación académica</h2>
    <p class="body-1">
      Trayectoria académica, certificaciones técnicas y formación continua.
    </p>
  </div>

  <!-- Panel principal dividido en 2 columnas -->
  <div class="grid grid-cols-1 overflow-hidden rounded-xl border border-easton-blue-500/80 bg-vellum-sheet shadow-[6px_6px_0_0_var(--color-wand-brown-500)] lg:grid-cols-[0.95fr_1.35fr]">
    <!-- Columna izquierda: editorial + composición geométrica -->
    <div class="flex flex-col justify-between border-b border-easton-blue-500/80 p-6 sm:p-8 lg:border-b-0 lg:border-r lg:p-10">
      <div class="space-y-6">
        <h3 class="font-display text-2xl font-bold text-easton-blue-500 sm:text-3xl">
          Siempre
          <br />
          aprendiendo.
        </h3>

        <p class="body-1 max-w-md text-easton-blue-500/85">
          Certificaciones y especializaciones enfocadas en bases de datos,
          microservicios, desarrollo backend y arquitectura de software.
        </p>
      </div>

      <!-- Composición geométrica inferior -->
      <div class="relative mt-10 flex min-h-56 items-end justify-between pt-6">
        <!-- Líneas punteadas de cuadrícula decorativa a la derecha -->
        <div
          class="pointer-events-none absolute right-6 top-6 h-28 w-28"
          aria-hidden="true"
        >
          <div class="absolute inset-x-0 top-1/2 border-t border-dashed border-wand-brown-500/50" />
          <div class="absolute inset-y-0 left-1/2 border-l border-dashed border-wand-brown-500/50" />
          <!-- Estrella marrón superior derecha -->
          <svg
            class="absolute -right-2 -top-2 h-6 w-6 text-wand-brown-500"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z" />
          </svg>
          <!-- Estrella amarilla pequeña -->
          <svg
            class="absolute bottom-3 left-7 h-4 w-4 text-lunar-yellow-500"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z" />
          </svg>
        </div>

        <!-- Figuras geométricas -->
        <div class="relative z-10 flex w-full items-end">
          <!-- Cuarto de círculo marrón -->
          <div
            class="h-28 w-24 shrink-0 rounded-tl-full bg-wand-brown-500"
            aria-hidden="true"
          />

          <div class="flex flex-1 flex-col">
            <!-- Círculo amarillo superior -->
            <div class="flex items-end gap-4 pl-2">
              <span
                class="h-20 w-20 shrink-0 rounded-full bg-mashle-red-500"
                aria-hidden="true"
              />
            </div>

            <!-- Rectángulo rojo + semicírculo inferior azul -->
            <div class="relative flex items-center bg-lunar-yellow-500 px-4 py-3">
              <span class="rounded bg-easton-blue-500 px-3 py-1 font-mono text-[11px] font-bold tracking-wider text-vellum-sheet">
                ESTUDIO CONSTANTE
              </span>

              <span
                class="ml-auto h-11 w-20 shrink-0 rounded-b-full bg-easton-blue-500"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna derecha: listado de certificaciones y formación -->
    <div class="flex flex-col justify-between bg-chalk-paper/60 lg:max-h-[650px] lg:overflow-y-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
      <ul class="divide-y divide-easton-blue-500/20">
        {items.map((item) => (
          <li
            class:list={[
              "group relative overflow-hidden",
              "before:content-[''] before:pointer-events-none before:absolute before:inset-0 before:z-0 before:bg-easton-blue-500",
              "before:origin-left before:scale-x-0 before:transition-transform before:duration-300 before:ease-out",
              "hover:before:scale-x-100",
            ]}
          >
            <div class="relative z-10 flex flex-col justify-between gap-3 px-6 py-5 sm:flex-row sm:items-center sm:gap-6 sm:px-8">
              <div class="flex flex-col items-start gap-1">
                <span class="mono-subtitle-3 text-wand-brown-500 transition-colors duration-300 group-hover:text-lunar-yellow-500">
                  {item.period}
                </span>

                <div class="space-y-0.5">
                  <h4 class="subtitle-main text-easton-blue-500 transition-colors duration-300 group-hover:text-chalk-paper">
                    {item.title}
                  </h4>
                  <p class="body-2 text-easton-blue-500 font-semibold transition-colors duration-300 group-hover:text-lunar-yellow-500">
                    {item.subtitle}
                  </p>
                  {item.description && (
                    <p class="caption pt-1 text-easton-blue-500/90 transition-colors duration-300 group-hover:text-lunar-yellow-500">
                      {item.description}
                    </p>
                  )}
                </div>
              </div>

              {item.badge && (
                <Chip
                  size="sm"
                  variant="solid"
                  style="filled"
                  color="lunar-yellow"
                  weight="medium"
                  case="normal"
                >
                  {item.badge}
                </Chip>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
