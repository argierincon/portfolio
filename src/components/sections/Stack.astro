---
import Chip from "../Chip.astro";

type ChipColor = "mashle-red" | "easton-blue" | "wand-brown" | "lunar-yellow";

interface ToolItem {
  name: string;
  color: ChipColor;
}

interface CategoryGroup {
  labels: readonly string[];
  tools: readonly ToolItem[];
}

const leftColumnGroups: readonly CategoryGroup[] = [
  {
    labels: ["Backend & Arquitectura"],
    tools: [
      { name: "Java", color: "mashle-red" },
      { name: "Spring Boot", color: "easton-blue" },
      { name: "Spring Security", color: "wand-brown" },
      { name: "Hibernate / JPA", color: "easton-blue" },
      { name: "Jakarta Validation", color: "lunar-yellow" },
      { name: "REST APIs", color: "easton-blue" },
      { name: "Arquitectura Hexagonal", color: "wand-brown" },
    ],
  },
];

const frontendGroup: CategoryGroup = {
  labels: ["Frontend"],
  tools: [
    { name: "JavaScript", color: "lunar-yellow" },
    { name: "TypeScript", color: "easton-blue" },
    { name: "React", color: "mashle-red" },
    { name: "Next.js", color: "easton-blue" },
    { name: "Vue 2/3", color: "wand-brown" },
    { name: "Nuxt", color: "lunar-yellow" },
    { name: "Pinia", color: "easton-blue" },
    { name: "Zustand", color: "wand-brown" },
    { name: "HTML5", color: "mashle-red" },
    { name: "CSS3", color: "easton-blue" },
    { name: "SASS", color: "mashle-red" },
    { name: "Tailwind CSS", color: "lunar-yellow" },
    { name: "Bootstrap", color: "wand-brown" },
  ],
};

const rightColumnGroups: readonly CategoryGroup[] = [
  {
    labels: ["Bases de Datos"],
    tools: [
      { name: "MySQL", color: "wand-brown" },
      { name: "SQL Server", color: "easton-blue" },
      { name: "MongoDB", color: "lunar-yellow" },
      { name: "Flyway", color: "mashle-red" },
    ],
  },
  {
    labels: ["Auth & Diseño"],
    tools: [
      { name: "Docker", color: "lunar-yellow" },
      { name: "Git", color: "mashle-red" },
      { name: "GitHub", color: "easton-blue" },
      { name: "Auth0", color: "wand-brown" },
      { name: "Firebase", color: "lunar-yellow" },
      { name: "UX/UI Design", color: "mashle-red" },
      { name: "Figma", color: "easton-blue" },
    ],
  },
];
---

<section class="container-sections space-y-8">
  <!-- Encabezado de sección -->
  <div class="max-w-2xl space-y-2">
    <h2 class="title-sections">Tecnologías con las que trabajo</h2>
    <p class="body-1">
      Herramientas y tecnologías que aplico con disciplina, organizadas como
      insignias de maestría.
    </p>
  </div>

  <!-- Contenedor principal tipo panel -->
  <div class="relative rounded-xl border border-easton-blue-500 bg-vellum-sheet p-6 sm:p-8 lg:p-10">
    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
      <!-- Columna 1: Backend + Herramientas & DevOps -->
      <div class="relative space-y-8">
        <!-- Efecto de cuadrícula punteada (dashed) y cuadradito marrón visible en mobile y desktop -->
        <div
          class="cuadricula pointer-events-none absolute inset-0 z-0"
          aria-hidden="true"
        >
          <!-- Líneas verticales punteadas (mismo sobresaliente arriba y abajo: 6%) -->
          <div class="absolute left-[28%] top-[23%] bottom-[13%] border-l border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[54%] top-[23%] bottom-[13%] border-l border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[78%] top-[23%] bottom-[13%] border-l border-dashed border-wand-brown-300/50" />

          <!-- Líneas horizontales punteadas -->
          <div class="absolute left-[22%] right-4 top-[29%] border-t border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[22%] right-4 top-[56%] border-t border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[22%] right-[22%] bottom-[19%] border-t border-dashed border-wand-brown-300/50" />

          <!-- Cuadradito marrón sobre la línea horizontal a la derecha de Git -->
          <span class="absolute right-[18%] top-[29%] h-3 w-3 -translate-y-1/2 rounded-[2px] bg-wand-brown-500" />
        </div>

        <!-- Contenido de la columna por encima de la cuadrícula -->
        <div class="relative z-10 space-y-8">
          {leftColumnGroups.map((group) => (
            <div class="space-y-4">
              <div class="flex flex-wrap items-center gap-2">
                {group.labels.map((label) => (
                  <Chip
                    size="md"
                    variant="soft"
                    style="outlined"
                    color="wand-brown"
                    case="normal"
                    weight="regular"
                  >
                    {label}
                  </Chip>
                ))}
              </div>

              <div class="flex flex-wrap gap-3">
                {group.tools.map((tool) => (
                  <Chip
                    size="md"
                    variant="solid"
                    style="filled"
                    color={tool.color}
                    case="normal"
                    weight="medium"
                  >
                    <span class="flex items-center gap-2">
                      <span
                        class="h-2 w-2 rounded-full bg-current opacity-80"
                        aria-hidden="true"
                      />
                      <span>{tool.name}</span>
                    </span>
                  </Chip>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna 2: Frontend -->
      <div class="relative space-y-4">
        <!-- Efecto de cuadrícula punteada (dashed) y estrellitas de fondo -->
        <div
          class="cuadricula pointer-events-none absolute inset-0 z-0"
          aria-hidden="true"
        >
          <!-- Líneas verticales punteadas (mismo sobresaliente arriba y abajo: 6%) -->
          <div class="absolute left-[28%] top-[23%] bottom-[13%] border-l border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[54%] top-[23%] bottom-[13%] border-l border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[78%] top-[23%] bottom-[13%] border-l border-dashed border-wand-brown-300/50" />

          <!-- Líneas horizontales punteadas -->
          <div class="absolute left-[22%] right-4 top-[29%] border-t border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[22%] right-4 top-[56%] border-t border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[22%] right-[22%] bottom-[19%] border-t border-dashed border-wand-brown-300/50" />

          <!-- Estrellita superior derecha (outlined) -->
          <svg
            class="absolute right-1 top-0 h-6 w-6 text-wand-brown-500"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
          >
            <path
              d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z"
              class="fill-lunar-yellow-500/35"
            />
          </svg>

          <!-- Estrellita inferior derecha (centrada en la intersección: left-[78%] + bottom-[19%]) -->
          <svg
            class="absolute left-[78%] bottom-[19%] h-5 w-5 -translate-x-1/2 translate-y-1/2 text-wand-brown-500"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z" />
          </svg>
        </div>

        <!-- Contenido de la columna por encima de la cuadrícula -->
        <div class="relative z-10 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            {frontendGroup.labels.map((label) => (
              <Chip
                size="md"
                variant="soft"
                style="outlined"
                color="wand-brown"
                case="normal"
                weight="regular"
              >
                {label}
              </Chip>
            ))}
          </div>

          <div class="flex flex-wrap gap-3">
            {frontendGroup.tools.map((tool) => (
              <Chip
                size="md"
                variant="solid"
                style="filled"
                color={tool.color}
                case="normal"
                weight="medium"
              >
                <span class="flex items-center gap-2">
                  <span
                    class="h-2 w-2 rounded-full bg-current opacity-80"
                    aria-hidden="true"
                  />
                  <span>{tool.name}</span>
                </span>
              </Chip>
            ))}
          </div>
        </div>
      </div>

      <!-- Columna 3: Bases de Datos -->
      <!-- Columna 3: Bases de Datos + Herramientas, Auth & Diseño -->
      <div class="relative isolate space-y-8">
        <!-- Efecto de cuadrícula punteada (dashed) y adornos de fondo -->
        <div
          class="pointer-events-none absolute inset-0 z-0"
          aria-hidden="true"
        >
          <!-- Líneas verticales punteadas -->
          <div class="absolute left-[26%] top-14 bottom-2 border-l border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[54%] top-14 bottom-4 border-l border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[82%] top-14 bottom-6 border-l border-dashed border-wand-brown-300/50" />

          <!-- Líneas horizontales punteadas -->
          <div class="absolute left-[22%] right-2 top-[44%] border-t border-dashed border-wand-brown-300/50" />
          <div class="absolute left-[22%] right-2 top-[72%] border-t border-dashed border-wand-brown-300/50" />

          <!-- Cuadradito marrón sobre la línea horizontal superior -->
          <span class="absolute left-[82%] top-[44%] h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-[2px] bg-wand-brown-500" />

          <!-- Brillito / estrella de cuatro puntas sobre la línea horizontal inferior -->
          <svg
            class="absolute left-[54%] top-[72%] h-5 w-5 -translate-x-1/2 -translate-y-1/2 text-wand-brown-500"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z" />
          </svg>

          <!-- Liniecita horizontal marrón sobre la línea vertical izquierda -->
          <span class="absolute left-[26%] top-[85%] h-1 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full bg-wand-brown-500" />
        </div>

        <!-- Contenido de la columna por encima de la cuadrícula -->
        <div class="relative z-10 space-y-8">
          {rightColumnGroups.map((group) => (
            <div class="space-y-4">
              <div class="flex flex-wrap items-center gap-2">
                {group.labels.map((label) => (
                  <Chip
                    size="md"
                    variant="soft"
                    style="outlined"
                    color="wand-brown"
                    case="normal"
                    weight="regular"
                    class="bg-vellum-sheet"
                  >
                    {label}
                  </Chip>
                ))}
              </div>

              <div class="flex flex-wrap gap-3">
                {group.tools.map((tool) => (
                  <Chip
                    size="md"
                    variant="solid"
                    style="filled"
                    color={tool.color}
                    case="normal"
                    weight="medium"
                  >
                    <span class="flex items-center gap-2">
                      <span
                        class="h-2 w-2 rounded-full bg-current opacity-80"
                        aria-hidden="true"
                      />
                      <span>{tool.name}</span>
                    </span>
                  </Chip>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
