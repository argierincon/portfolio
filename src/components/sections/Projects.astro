---
import VerticalAccordion, {
  type AccordionItem,
} from "../VerticalAccordion.astro";

const projects: readonly AccordionItem[] = [
  {
    id: "proyecto-inventario",
    meta: "SISTEMAS INDUSTRIALES · WEB · BACKEND",
    title: "Gestor de Inventario y Procesos",
    shortTitle: "Gestor de Inventario",
    description:
      "Automatización de flujos de stock y control de mermas industriales. Sistema transaccional robusto diseñado para plantas de manufactura con sincronización en tiempo real y reportería avanzada.",
    highlights: [
      "Control de merma y stock en tiempo real",
      "Arquitectura limpia con Spring Boot y JPA",
      "Panel analítico de eficiencia operativa",
      "API REST documentada con OpenAPI / Swagger",
    ],
    tags: [
      "Java 25",
      "Spring Boot",
      "MySQL",
      "React",
      "Docker",
      "REST APIs",
      "Hibernate",
    ],
    actions: [
      { label: "Ver en GitHub", href: "#contacto", variant: "primary" },
      { label: "Demo en vivo", href: "#contacto", variant: "secondary" },
    ],
    illustrationLabel: "ILLUSTRATIVE UI",
    collapsedTone: "sheet",
    buttonTone: "red",
  },
  {
    id: "proyecto-reservas",
    meta: "BACKEND · APIS · ARQUITECTURA",
    title: "API de Reservas y Turnos",
    shortTitle: "API de Reservas y Turnos",
    description:
      "Servicio backend diseñado para gestionar disponibilidad, turnos y reservas con validaciones de negocio consistentes y documentación clara de endpoints.",
    highlights: [
      "Control de disponibilidad y concurrencia",
      "Arquitectura modular y mantenible",
      "Validación de datos y manejo estructurado de errores",
      "Contenerización lista para entornos de prueba y producción",
    ],
    tags: ["Java", "Spring Boot", "Spring Security", "PostgreSQL", "Docker"],
    actions: [
      { label: "Ver en GitHub", href: "#contacto", variant: "primary" },
    ],
    illustrationLabel: "ILLUSTRATIVE UI",
    collapsedTone: "sheet",
    buttonTone: "red",
  },
  {
    id: "proyecto-panel",
    meta: "FULL STACK · INTERFAZ · DATOS",
    title: "Panel Operativo Full Stack",
    shortTitle: "Panel Operativo Full Stack",
    description:
      "Interfaz operativa conectada a servicios backend para monitorear estados, consultar registros y agilizar la toma de decisiones diarias.",
    highlights: [
      "Componentes reutilizables y diseño responsive",
      "Integración fluida con servicios REST",
      "Visualización clara de indicadores clave",
      "Base preparada para escalar nuevas vistas",
    ],
    tags: ["TypeScript", "React", "Tailwind CSS", "Spring Boot", "MySQL"],
    actions: [
      { label: "Ver en GitHub", href: "#contacto", variant: "primary" },
      { label: "Demo en vivo", href: "#contacto", variant: "secondary" },
    ],
    illustrationLabel: "ILLUSTRATIVE UI",
    collapsedTone: "yellow",
    buttonTone: "blue",
  },
  {
    id: "proyecto-panel",
    meta: "FULL STACK · INTERFAZ · DATOS",
    title: "Panel Operativo Full Stack",
    shortTitle: "Panel Operativo Full Stack",
    description:
      "Interfaz operativa conectada a servicios backend para monitorear estados, consultar registros y agilizar la toma de decisiones diarias.",
    highlights: [
      "Componentes reutilizables y diseño responsive",
      "Integración fluida con servicios REST",
      "Visualización clara de indicadores clave",
      "Base preparada para escalar nuevas vistas",
    ],
    tags: ["TypeScript", "React", "Tailwind CSS", "Spring Boot", "MySQL"],
    actions: [
      { label: "Ver en GitHub", href: "#contacto", variant: "primary" },
      { label: "Demo en vivo", href: "#contacto", variant: "secondary" },
    ],
    illustrationLabel: "ILLUSTRATIVE UI",
    collapsedTone: "yellow",
    buttonTone: "blue",
  },
];
---

<section id="proyectos" class="container-sections relative isolate space-y-8">
  <!-- Adornos decorativos de fondo -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <!-- Superior derecha: círculo outlined, estrella de 4 puntas y polígono -->
    <span class="absolute right-24 top-16 h-3.5 w-3.5 rounded-full border-2 border-wand-brown-500/80" />

    <svg
      class="absolute right-8 top-10 h-10 w-10 text-wand-brown-500"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    >
      <path
        d="M12 1.5C12.5 7.8 16.2 11.5 22.5 12C16.2 12.5 12.5 16.2 12 22.5C11.5 16.2 7.8 12.5 1.5 12C7.8 11.5 11.5 7.8 12 1.5Z"
        class="fill-lunar-yellow-500/45"
      />
    </svg>

    <svg
      class="absolute right-6 top-28 h-4 w-4 text-wand-brown-500"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    >
      <polygon
        points="12,2 21,7 21,17 12,22 3,17 3,7"
        class="fill-wand-brown-300/25"
      />
    </svg>

    <!-- Inferior izquierda: estrella/sello rojo -->
    <svg
      class="absolute -left-2 bottom-8 h-9 w-9 text-mashle-red-500"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 1.5l2.7 3.2 4.1-.6.6 4.1 3.2 2.7-2.2 3.5.9 4-4 .9-3.5 2.2-3.5-2.2-4-.9.9-4L2.2 11.4l3.2-2.7.6-4.1 4.1.6L12 1.5z" />
    </svg>
  </div>

  <!-- Encabezado de sección -->
  <div class="relative z-10 max-w-xl space-y-2">
    <h2 class="title-sections">Proyectos Recientes</h2>
    <p class="body-1">
      Soluciones web estructuradas desde la lógica de negocio hasta la interfaz.
      <span class="block">Haz clic para expandir cada proyecto.</span>
    </p>
  </div>

  <!-- Acordeón vertical -->
  <div class="relative z-10">
    <VerticalAccordion items={projects} defaultOpenIndex={0} />
  </div>
</section>
