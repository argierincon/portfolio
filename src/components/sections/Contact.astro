---
interface SocialLink {
  name: string;
  handleText: string;
  href: string;
  variant: "dark" | "sheet" | "yellow";
  network: "linkedin" | "github" | "instagram";
}

const socials: readonly SocialLink[] = [
  {
    name: "LinkedIn",
    handleText: "linkedin.com/in/argierincon",
    href: "https://www.linkedin.com/in/argierincon",
    variant: "dark",
    network: "linkedin",
  },
  {
    name: "GitHub",
    handleText: "github.com/argierincon",
    href: "https://github.com/argierincon",
    variant: "sheet",
    network: "github",
  },
  {
    name: "argie.rincon",
    handleText: "argie.rincon en Instagram",
    href: "https://www.instagram.com/argie.rincon",
    variant: "yellow",
    network: "instagram",
  },
];
---

<section id="contacto" class="container-sections space-y-6">
  <!-- Encabezado superior -->
  <div class="space-y-2">
    <h2 class="font-display text-4xl font-bold tracking-tight text-mashle-red-500 sm:text-5xl">
      CONTACTO
    </h2>
    <p class="body-1 text-easton-blue-500/85">
      Sin formularios largos ni spam. Hablemos de ingeniería, código o proyectos
      a través de mis redes profesionales.
    </p>
  </div>

  <!-- Tarjeta principal -->
  <div class="relative rounded-xl border border-easton-blue-500 bg-vellum-sheet shadow-[6px_6px_0_0_var(--color-wand-brown-500)]">
    <div class="grid grid-cols-1 items-center gap-8 p-6 sm:p-8 lg:grid-cols-[1.15fr_0.95fr] lg:gap-10 lg:p-12">
      <!-- Columna izquierda: texto y botones -->
      <div class="relative z-10 space-y-6">
        <span class="inline-block rounded-full border border-easton-blue-500 bg-lunar-yellow-500 px-3.5 py-1 font-mono text-[11px] font-bold tracking-widest text-easton-blue-500">
          CONTACT
        </span>

        <h3 class="font-display text-4xl font-bold tracking-tight text-easton-blue-500 sm:text-6xl">
          ¡Hablemos!
        </h3>

        <div class="max-w-xl space-y-3">
          <p class="font-sans text-base font-bold leading-snug text-easton-blue-500 sm:text-lg">
            ¿Tienes un proyecto, un equipo o un reto técnico? Conectemos
            directamente.
          </p>
          <p class="font-sans text-sm leading-relaxed text-easton-blue-500/85 sm:text-base">
            Me enfoco en desarrollo Full Stack Java y Spring Boot con disciplina
            y arquitectura sólida. Si buscas colaborar o sumar talento, puedes
            encontrarme y escribirme directamente en mis canales activos.
          </p>
        </div>

        <!-- Botones de redes -->
        <div class="flex flex-wrap items-center gap-3.5 pt-1">
          {socials.map((item) => {
            const buttonClasses =
              item.variant === "dark"
                ? "bg-easton-blue-500 text-chalk-paper shadow-[3px_3px_0_0_var(--color-wand-brown-500)]"
                : item.variant === "yellow"
                  ? "bg-lunar-yellow-500 text-easton-blue-500 shadow-[3px_3px_0_0_var(--color-easton-blue-500)]"
                  : "bg-chalk-paper text-easton-blue-500 shadow-[3px_3px_0_0_var(--color-easton-blue-500)]";

            return (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "inline-flex items-center gap-2.5 rounded-xl border border-easton-blue-500 px-4 py-2.5 font-sans text-sm font-semibold transition-transform duration-150 hover:-translate-y-0.5 active:translate-y-0",
                  buttonClasses,
                ]}
              >
                {item.network === "linkedin" && (
                  <span class="inline-flex h-4 w-4 items-center justify-center rounded-[3px] bg-chalk-paper font-sans text-[10px] font-extrabold text-easton-blue-500">
                    in
                  </span>
                )}

                {item.network === "github" && (
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.52.1.72-.22.72-.5v-1.9c-2.94.64-3.56-1.25-3.56-1.25-.48-1.22-1.18-1.55-1.18-1.55-.96-.66.07-.65.07-.65 1.07.08 1.63 1.1 1.63 1.1.95 1.62 2.48 1.15 3.09.88.1-.69.37-1.15.67-1.42-2.35-.27-4.82-1.17-4.82-5.22 0-1.15.41-2.1 1.09-2.84-.11-.27-.47-1.35.1-2.82 0 0 .89-.28 2.91 1.08a10.1 10.1 0 0 1 5.3 0c2.02-1.36 2.91-1.08 2.91-1.08.57 1.47.21 2.55.1 2.82.68.74 1.09 1.69 1.09 2.84 0 4.06-2.47 4.95-4.83 5.21.38.33.72.97.72 1.96v2.9c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5Z" />
                  </svg>
                )}

                {item.network === "instagram" && (
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle
                      cx="17.5"
                      cy="6.5"
                      r="1"
                      fill="currentColor"
                      stroke="none"
                    />
                  </svg>
                )}

                <span>{item.name}</span>
                <span class="font-mono text-xs opacity-80" aria-hidden="true">
                  ↗
                </span>
              </a>
            );
          })}
        </div>

        <!-- Pie de enlaces directos -->
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 border-t border-wand-brown-300/40 pt-4 font-mono text-xs text-wand-brown-500">
          <a
            href={socials[2].href}
            target="_blank"
            rel="noopener noreferrer"
            class="break-words hover:text-easton-blue-500"
          >
            {socials[2].handleText}
          </a>
          <span aria-hidden="true">·</span>
          <a
            href={socials[0].href}
            target="_blank"
            rel="noopener noreferrer"
            class="break-all hover:text-easton-blue-500"
          >
            {socials[0].handleText}
          </a>
          <span aria-hidden="true">·</span>
          <a
            href={socials[1].href}
            target="_blank"
            rel="noopener noreferrer"
            class="break-all hover:text-easton-blue-500"
          >
            {socials[1].handleText}
          </a>
        </div>
      </div>

      <!-- Columna derecha: composición geométrica + escena del escritorio -->
      <div class="relative flex min-h-80 items-center justify-center">
        <!-- Líneas punteadas inferiores -->
        <div
          class="pointer-events-none absolute bottom-0 left-6 h-44 w-40"
          aria-hidden="true"
        >
          <div class="absolute inset-y-0 left-1/2 border-l border-dashed border-wand-brown-300/50" />
          <div class="absolute inset-x-0 top-1/3 border-t border-dashed border-wand-brown-300/50" />
          <div class="absolute inset-x-0 bottom-10 border-t border-dashed border-wand-brown-300/50" />
        </div>

        <!-- Formas geométricas inferiores izquierdas -->
        <div class="pointer-events-none relative z-10 mt-28 flex items-end">
          <div class="flex flex-col items-center">
            <div class="h-14 w-24 rounded-t-full bg-mashle-red-500" />
            <div class="my-3 h-14 w-14 rounded-full bg-lunar-yellow-500" />
          </div>
          <div class="-ml-2 h-28 w-32 border border-easton-blue-500 bg-easton-blue-500" />
        </div>

        <!-- Marco en arco con escena de trabajo -->
        <div class="relative z-10 -ml-8 w-full max-w-sm">
          <!-- Burbuja "¡Hola!" -->
          <div class="absolute -left-2 top-3 z-20 -rotate-6 rounded-xl border border-easton-blue-500 bg-lunar-yellow-500 px-3 py-1 font-sans text-xs font-bold text-easton-blue-500 shadow-[2px_2px_0_0_var(--color-easton-blue-500)]">
            ¡Hola! 👋
          </div>

          <div class="overflow-hidden rounded-t-full border-2 border-easton-blue-500 bg-wand-brown-500 pt-10 px-4 pb-0">
            <svg
              class="h-auto w-full"
              viewBox="0 0 320 260"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-label="Ilustración de estación de trabajo con código"
            >
              <!-- Pizarra de figuras detrás -->
              <rect
                x="132"
                y="26"
                width="128"
                height="118"
                rx="6"
                class="fill-chalk-paper stroke-easton-blue-500"
                stroke-width="2"
              />
              <circle
                cx="164"
                cy="58"
                r="14"
                class="fill-mashle-red-500 stroke-easton-blue-500"
                stroke-width="2"
              />
              <rect
                x="150"
                y="90"
                width="26"
                height="26"
                rx="3"
                class="fill-lunar-yellow-500 stroke-easton-blue-500"
                stroke-width="2"
              />
              <polygon
                points="212,50 232,82 192,82"
                class="fill-easton-blue-500"
              />

              <!-- Escritorio -->
              <polygon
                points="28,154 218,122 292,162 96,202"
                class="fill-vellum-sheet stroke-easton-blue-500"
                stroke-width="2.5"
                stroke-linejoin="round"
              />
              <polygon
                points="96,202 292,162 292,174 96,214"
                class="fill-wand-brown-300 stroke-easton-blue-500"
                stroke-width="2"
                stroke-linejoin="round"
              />

              <!-- Laptop -->
              <polygon
                points="76,158 164,142 184,154 96,171"
                class="fill-chalk-paper stroke-easton-blue-500"
                stroke-width="2"
                stroke-linejoin="round"
              />
              <polygon
                points="76,158 76,84 164,68 164,142"
                class="fill-easton-blue-500 stroke-easton-blue-500"
                stroke-width="2"
                stroke-linejoin="round"
              />
              <line
                x1="90"
                y1="92"
                x2="148"
                y2="82"
                class="stroke-lunar-yellow-500"
                stroke-width="3"
                stroke-linecap="round"
              />
              <line
                x1="90"
                y1="104"
                x2="136"
                y2="96"
                class="stroke-chalk-paper"
                stroke-width="3"
                stroke-linecap="round"
              />
              <line
                x1="90"
                y1="116"
                x2="144"
                y2="106"
                class="stroke-mashle-red-500"
                stroke-width="3"
                stroke-linecap="round"
              />

              <!-- Libreta amarilla -->
              <polygon
                points="62,174 102,166 118,176 78,184"
                class="fill-lunar-yellow-500 stroke-easton-blue-500"
                stroke-width="2"
                stroke-linejoin="round"
              />

              <!-- Taza -->
              <rect
                x="234"
                y="128"
                width="22"
                height="24"
                rx="3"
                class="fill-chalk-paper stroke-easton-blue-500"
                stroke-width="2"
              />
              <path
                d="M256 133h6a5 5 0 0 1 0 10h-6"
                class="stroke-easton-blue-500"
                stroke-width="2"
              />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
