---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  variant?:
    | "chalk-paper"
    | "vellum-sheet"
    | "easton-blue"
    | "lunar-yellow"
    | "wand-brown";
  id?: string;
}

const { variant = "vellum-sheet", id = "mobile-nav" } = Astro.props;

const navItems: readonly NavItem[] = [
  { label: "SOBRE MÍ", href: "#sobre-mi" },
  { label: "EXPERIENCIAS", href: "#experiencias" },
  { label: "STACK", href: "#stack" },
  { label: "PROYECTOS", href: "#proyectos" },
  { label: "EDUCACIÓN", href: "#educacion" },
];

const variants = {
  "chalk-paper": {
    header: "border-wand-brown-300/40 bg-chalk-paper backdrop-blur-xs",
    brand: "text-easton-blue-500 hover:text-mashle-red-500",
    nav: "text-easton-blue-500 hover:text-mashle-red-500",
    cta: "bg-mashle-red-500 text-chalk-paper",
    toggle: "border-easton-blue-500 bg-vellum-sheet text-easton-blue-500",
    mobileMenu: "border-wand-brown-300/40 bg-chalk-paper",
    mobileLink: "text-easton-blue-500 hover:text-mashle-red-500",
  },
  "vellum-sheet": {
    header: "border-wand-brown-300/40 bg-vellum-sheet/95 backdrop-blur-xs",
    brand: "text-easton-blue-500 hover:text-mashle-red-500",
    nav: "text-easton-blue-500 hover:text-mashle-red-500",
    cta: "bg-mashle-red-500 text-chalk-paper",
    toggle: "border-easton-blue-500 bg-vellum-sheet text-easton-blue-500",
    mobileMenu: "border-wand-brown-300/40 bg-vellum-sheet",
    mobileLink: "text-easton-blue-500 hover:text-mashle-red-500",
  },
  "easton-blue": {
    header: "border-vellum-sheet/15 bg-easton-blue-500/95",
    brand: "text-vellum-sheet hover:text-lunar-yellow-500",
    nav: "text-easton-blue-100 hover:text-lunar-yellow-500",
    cta: "bg-lunar-yellow-500 text-easton-blue-500 hover:bg-lunar-yellow-600 active:bg-lunar-yellow-700",
    toggle: "border-vellum-sheet/60 bg-easton-blue-600 text-vellum-sheet",
    mobileMenu: "border-vellum-sheet/15 bg-easton-blue-500",
    mobileLink: "text-vellum-sheet hover:text-lunar-yellow-500",
  },
  "lunar-yellow": {
    header: "border-easton-blue-500/15 bg-lunar-yellow-500/95",
    brand: "text-easton-blue-500 hover:text-mashle-red-500",
    nav: "text-easton-blue-500 hover:text-mashle-red-500",
    cta: "bg-easton-blue-500 text-chalk-paper hover:bg-easton-blue-600 active:bg-easton-blue-700",
    toggle: "border-easton-blue-500 bg-vellum-sheet text-easton-blue-500",
    mobileMenu: "border-easton-blue-500/15 bg-lunar-yellow-100",
    mobileLink: "text-easton-blue-500 hover:text-mashle-red-500",
  },
  "wand-brown": {
    header: "border-wand-brown-300/40 bg-wand-brown-500/95",
    brand: "text-vellum-sheet hover:text-lunar-yellow-500",
    nav: "text-wand-brown-100 hover:text-lunar-yellow-500",
    cta: "bg-vellum-sheet text-wand-brown-700 hover:bg-wand-brown-100 active:bg-wand-brown-200",
    toggle: "border-vellum-sheet/60 bg-wand-brown-600 text-vellum-sheet",
    mobileMenu: "border-vellum-sheet/15 bg-wand-brown-500",
    mobileLink: "text-vellum-sheet hover:text-lunar-yellow-500",
  },
} as const;

const v = variants[variant];
---

<header data-header class={`top-0 z-40 border-b ${v.header}`}>
  <div class="container-sections flex h-20 items-center justify-between gap-4">
    <!-- Marca / Nombre -->
    <a
      href="#"
      class={`font-display text-lg font-bold tracking-wider transition-colors sm:text-xl ${v.brand}`}
    >
      ARGIE RINCON
    </a>

    <!-- Navegación en escritorio -->
    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`text-xs font-semibold tracking-widest transition-colors ${v.nav}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- CTA + Botón hamburguesa en móvil -->
    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class={`inline-flex items-center justify-center rounded-md px-5 py-2.5 font-sans text-sm font-semibold transition-transform duration-150 hover:-translate-y-0.5 active:translate-y-0 ${v.cta}`}
      >
        Contáctame
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls={id}
        aria-label="Abrir menú de navegación"
        class={`inline-flex h-10 w-10 items-center justify-center rounded-xl border lg:hidden ${v.toggle}`}
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable en móvil -->
  <nav
    id={id}
    data-mobile-menu
    aria-label="Navegación móvil"
    class={`hidden border-t lg:hidden ${v.mobileMenu}`}
  >
    <ul class="container-sections flex flex-col gap-3 py-4">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            data-mobile-link
            class={`block py-1.5 font-mono text-xs font-semibold tracking-widest transition-colors ${v.mobileLink}`}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>("[data-header]").forEach((header) => {
    const toggleBtn =
      header.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const mobileMenu = header.querySelector<HTMLElement>("[data-mobile-menu]");
    const mobileLinks =
      header.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]");

    toggleBtn?.addEventListener("click", () => {
      const isOpen = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", String(!isOpen));
      mobileMenu?.classList.toggle("hidden", isOpen);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        toggleBtn?.setAttribute("aria-expanded", "false");
        mobileMenu?.classList.add("hidden");
      });
    });
  });
</script>
