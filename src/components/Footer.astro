---
import EastonChip from "./EastonChip.astro";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const leftLinks: readonly FooterLink[] = [
  { label: "Inicio", href: "#" },
  { label: "Acerca de mí", href: "#sobre-mi" },
];

const middleLinks: readonly FooterLink[] = [
  { label: "Experiencia", href: "#experiencias" },
  { label: "Stack", href: "#stack" },
];

const rightLinks: readonly FooterLink[] = [
  { label: "Proyectos", href: "#proyectos" },
  { label: "Formación", href: "#formacion" },
];

const socials: readonly FooterLink[] = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/argierincon",
    external: true,
  },
  {
    label: "GitHub",
    href: "https://github.com/argierincon",
    external: true,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/argie.rincon",
    external: true,
  },
];
---

<footer class="relative overflow-hidden bg-mashle-red-500 text-chalk-paper">
  <!-- Corte superior diagonal con vértice / punta central hacia abajo -->
  <div class="relative w-full" aria-hidden="true">
    <svg
      class="block h-20 w-full sm:h-28 lg:h-32"
      viewBox="0 0 1440 160"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Fondo superior de transición (papel o sección anterior) con punta hacia abajo en el centro -->
      <polygon
        points="0,0 1440,0 1440,28 765,112 720,152 675,112 0,28"
        class="fill-chalk-paper"
      />

      <!-- Línea decorativa siguiendo el ángulo -->
      <polyline
        points="0,36 672,120 720,160 768,120 1440,36"
        class="stroke-lunar-yellow-500/70"
        stroke-width="2"
        fill="none"
      />
    </svg>
  </div>

  <div class="container-sections pt-2 pb-12">
    <!-- Emblema central: Nombre + Triángulos hacia adentro + Rol -->
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <div class="flex items-center justify-center gap-1 sm:gap-2 md:gap-3">
        <!-- Triángulo izquierdo apuntando hacia adentro -->
        <svg
          class="h-5 w-4 shrink-0 text-chalk-paper sm:h-7 sm:w-5"
          viewBox="0 0 20 28"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="0,0 20,14 0,28" />
        </svg>

        <p class="font-display text-4xl font-black uppercase tracking-tight text-chalk-paper drop-shadow-[0_4px_0_var(--color-easton-blue-500)] sm:text-6xl lg:text-7xl">
          ARGIE RINCÓN
        </p>

        <!-- Triángulo derecho apuntando hacia adentro -->
        <svg
          class="h-5 w-4 shrink-0 text-chalk-paper sm:h-7 sm:w-5"
          viewBox="0 0 20 28"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="20,0 0,14 20,28" />
        </svg>
      </div>

      <!-- Subtítulo / Rol -->
      <EastonChip class="mt-3 min-w-[250px]" variant="solid" style="filled" color="easton-blue" size="md">
        FULL STACK<br />JAVA DEVELOPER
      </EastonChip>
    </div>

    <!-- Zona inferior: enlaces y redes -->
    <div class="mt-14 grid grid-cols-1 items-start gap-10 border-t border-chalk-paper/15 pt-10 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <!-- Columnas de navegación -->
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
        <ul class="space-y-3">
          {leftLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-display text-lg font-bold text-chalk-paper transition-colors hover:text-lunar-yellow-500 sm:text-xl"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="space-y-3">
          {middleLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-display text-lg font-bold text-chalk-paper transition-colors hover:text-lunar-yellow-500 sm:text-xl"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="space-y-3">
          {rightLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-display text-lg font-bold text-chalk-paper transition-colors hover:text-lunar-yellow-500 sm:text-xl"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Bloque derecho: tarjeta de estado + canales + volver arriba -->
      <div class="flex flex-col items-start gap-4 lg:items-end">
        <div class="flex flex-wrap items-center gap-3 rounded-xl border border-easton-blue-500 bg-easton-blue-500 px-4 py-2.5 shadow-[3px_3px_0_0_var(--color-lunar-yellow-500)]">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-lunar-yellow-500">
            Lima, Perú
          </span>
          <span class="text-chalk-paper/40" aria-hidden="true">
            ·
          </span>
          <a
            href="#contacto"
            class="font-mono text-xs font-semibold text-chalk-paper underline-offset-4 hover:text-lunar-yellow-500 hover:underline"
          >
            Contacto
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-chalk-paper/90">
          <span class="font-semibold uppercase tracking-widest text-lunar-yellow-500">
            Oficial
          </span>
          {socials.map((social) => (
            <a
              href={social.href}
              target={social.external ? "_blank" : undefined}
              rel={social.external ? "noopener noreferrer" : undefined}
              class="transition-colors hover:text-lunar-yellow-500"
            >
              {social.label}
            </a>
          ))}
          <a
            href="#"
            class="rounded border border-chalk-paper/40 px-2.5 py-1 text-chalk-paper transition-colors hover:border-lunar-yellow-500 hover:text-lunar-yellow-500"
          >
            Arriba ↑
          </a>
        </div>
      </div>
    </div>

    <!-- Créditos base -->
    <div class="mt-8 flex flex-col justify-between gap-2 border-t border-chalk-paper/15 pt-5 font-mono text-xs text-chalk-paper/75 sm:flex-row">
      <p>© 2026 Argie Rincón</p>
      <p>Java 25 · Spring Boot · Astro</p>
    </div>
  </div>
</footer>

