---
import EastonChip from "./EastonChip.astro";

const currentYear = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const leftLinks: readonly FooterLink[] = [
  { label: "Inicio", href: "#" },
  { label: "Acerca de mí", href: "#sobre-mi" },
];

const middleLinks: readonly FooterLink[] = [
  { label: "Experiencia", href: "#experiencias" },
  { label: "Stack", href: "#stack" },
];

const rightLinks: readonly FooterLink[] = [
  { label: "Proyectos", href: "#proyectos" },
  { label: "Formación", href: "#formacion" },
];

const socials: readonly FooterLink[] = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/argierincon",
    external: true,
  },
  {
    label: "GitHub",
    href: "https://github.com/argierincon",
    external: true,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/argie.rincon",
    external: true,
  },
];
---

<footer class="relative overflow-hidden bg-mashle-red-500 text-vellum-sheet">
  <!-- Corte superior diagonal con vértice / punta central hacia abajo -->
  <div class="relative w-full" aria-hidden="true">
    <svg
      class="block h-20 w-full sm:h-28 lg:h-32"
      viewBox="0 0 1440 160"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Fondo superior de transición (papel o sección anterior) con punta hacia abajo en el centro -->
      <polygon
        points="0,0 1440,0 1440,28 765,112 720,152 675,112 0,28"
        class="fill-vellum-sheet"
      />

      <!-- Línea decorativa siguiendo el ángulo -->
      <polyline
        points="0,36 672,120 720,160 768,120 1440,36"
        class="stroke-lunar-yellow-500/70"
        stroke-width="2"
        fill="none"
      />
    </svg>
  </div>

  <div class="container-sections py-10 pb-12 md:pt-14 lg:pt-18">
    <!-- Emblema central: Nombre + Triángulos hacia adentro + Rol -->
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center gap-6">
      <div class="flex items-center justify-center gap-1 sm:gap-2 md:gap-3 transition-transform duration-300 hover:scale-105 hover:-rotate-5">
        <!-- Triángulo izquierdo apuntando hacia adentro -->
        <svg
          class="h-5 w-4 shrink-0 text-vellum-sheet sm:h-7 sm:w-5"
          viewBox="0 0 20 28"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="0,0 20,14 0,28" />
        </svg>

        <p class="font-display text-4xl font-black uppercase tracking-tight text-vellum-sheet drop-shadow-[0_4px_0_var(--color-easton-blue-500)] sm:text-6xl lg:text-7xl">
          ARGIE RINCÓN
        </p>

        <!-- Triángulo derecho apuntando hacia adentro -->
        <svg
          class="h-5 w-4 shrink-0 text-vellum-sheet sm:h-7 sm:w-5"
          viewBox="0 0 20 28"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="20,0 0,14 20,28" />
        </svg>
      </div>

      <!-- Subtítulo / Rol -->
      <EastonChip
        class="mt-3 min-w-[250px] transition-transform duration-300 hover:scale-[1.08]"
        variant="solid"
        style="filled"
        color="easton-blue"
        size="md"
      >
        FULL STACK
        <br />
        JAVA DEVELOPER
      </EastonChip>
    </div>

    <!-- Zona inferior: enlaces y redes -->
    <div class="mt-14 flex justify-center border-t border-vellum-sheet/20 py-14">
      <!-- Columnas de navegación -->
      <div class="grid w-full max-w-2xl grid-cols-1 gap-3 text-center md:grid-cols-3 md:gap-8">
        <ul class="space-y-3">
          {leftLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-block font-display text-lg font-bold text-vellum-sheet transition-[color,transform,letter-spacing] duration-300 ease-out hover:text-lunar-yellow-500 hover:translate-x-2 hover:-skew-x-[12deg] hover:tracking-[0.12em] sm:text-xl"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="space-y-3">
          {middleLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-block font-display text-lg font-bold text-vellum-sheet transition-[color,transform,letter-spacing] duration-300 ease-out hover:text-lunar-yellow-500 hover:translate-x-2 hover:-skew-x-[12deg] hover:tracking-[0.12em] sm:text-xl"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="space-y-3">
          {rightLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-block font-display text-lg font-bold text-vellum-sheet transition-[color,transform,letter-spacing] duration-300 ease-out hover:text-lunar-yellow-500 hover:translate-x-2 hover:-skew-x-[12deg] hover:tracking-[0.12em] sm:text-xl"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Créditos base -->
    <div class="flex flex-col items-center justify-center gap-6 border-t border-vellum-sheet/20 pt-5 md:flex-row md:items-center md:justify-between">
      <p class="mono-caption text-center text-vellum-sheet md:text-start">
        © {currentYear} Argie Rincón
      </p>
      <div class="flex flex-col items-center gap-3 mono-caption text-vellum-sheet md:flex-row md:flex-wrap md:gap-4">
        <span class="mono-caption font-semibold uppercase tracking-widest text-lunar-yellow-500">
          Oficial
        </span>
        {socials.map((social) => (
          <a
            href={social.href}
            target={social.external ? "_blank" : undefined}
            rel={social.external ? "noopener noreferrer" : undefined}
            class="transition-colors hover:text-lunar-yellow-500"
          >
            {social.label}
          </a>
        ))}
        <a
          href="#"
          class="mt-1 rounded border border-vellum-sheet/80 px-2.5 py-1 text-vellum-sheet transition-colors hover:border-lunar-yellow-500 hover:text-lunar-yellow-500 md:ml-3 md:mt-0"
        >
          Arriba ↑
        </a>
      </div>
    </div>
  </div>
</footer>
