---
import ActionButton from "./ActionButton.astro";
import Chip from "./Chip.astro";

export interface AccordionHighlight {
  text: string;
}

export interface AccordionAction {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
}

export interface AccordionItem {
  id: string;
  index?: string;
  meta?: string;
  title: string;
  shortTitle: string;
  description: string;
  highlights?: readonly string[];
  tags?: readonly string[];
  actions?: readonly AccordionAction[];
  illustrationLabel?: string;
  /** Variante visual cuando está colapsada */
  collapsedTone?: "sheet" | "yellow";
  /** Color del botón circular "+" cuando está colapsada */
  buttonTone?: "red" | "blue";
}

interface Props {
  items: readonly AccordionItem[];
  defaultOpenIndex?: number;
  class?: string;
}

const { items, defaultOpenIndex = 0, class: className = "" } = Astro.props;
---

<div
  data-vertical-accordion
  class:list={[
    "flex flex-col gap-4 md:min-h-[700px] lg:flex-row lg:items-stretch lg:gap-4",
    className,
  ]}
>
  {items.map((item, idx) => {
    const isExpanded = idx === defaultOpenIndex;
    const itemIndex = item.index ?? (idx + 1).toString().padStart(2, "0");

    return (
      <article
        id={item.id}
        data-accordion-panel
        data-expanded={isExpanded ? "true" : "false"}
        class:list={[
          "group relative overflow-hidden rounded-xl border border-easton-blue-500/80 bg-vellum-sheet shadow-[4px_4px_0_0_var(--color-wand-brown-500)]",
          "transition-[flex,padding] duration-500 ease-[cubic-bezier(0.25,0.8,0.25,1)]",
          isExpanded
            ? "p-6 sm:p-8 lg:flex-[1_1_0%] lg:p-10"
            : "p-0 lg:flex-[0_0_6rem]",
        ]}
      >
        <!-- CONTENIDO EXPANDIDO (sin display:none para permitir transición tipo Bootstrap) -->
        <div
          data-accordion-content
          aria-hidden={!isExpanded}
          class:list={[
            "grid transition-[grid-template-rows,opacity] duration-500 ease-[cubic-bezier(0.25,0.8,0.25,1)]",
            isExpanded
              ? "grid-rows-[1fr] opacity-100 delay-100 lg:h-full"
              : "pointer-events-none grid-rows-[0fr] opacity-0",
          ]}
        >
          <div class="min-h-0 overflow-hidden">
            <div class="grid grid-cols-1 gap-8 xl:grid-cols-[1.15fr_0.95fr] xl:items-center">
              <div class="space-y-6">
                <div class="space-y-2">
                  {item.meta && (
                    <p class="font-mono text-xs font-semibold tracking-widest text-wand-brown-500">
                      {itemIndex} · {item.meta}
                    </p>
                  )}
                  <h3 class="font-display text-2xl font-bold text-easton-blue-500 sm:text-3xl">
                    {item.title}
                  </h3>
                </div>

                <p class="body-1 text-easton-blue-500/85">{item.description}</p>

                {item.highlights && item.highlights.length > 0 && (
                  <ul class="space-y-2.5 body-2">
                    {item.highlights.map((point) => (
                      <li class="flex items-start gap-2.5 text-easton-blue-500/85">
                        <span
                          class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-wand-brown-500 text-chalk-paper"
                          aria-hidden="true"
                        >
                          <svg
                            class="h-2.5 w-2.5"
                            viewBox="0 0 12 12"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              d="M2.5 6.2L5 8.7L9.5 3.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {item.tags && item.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {item.tags.map((tag) => (
                      <Chip
                        variant="soft"
                        style="filled"
                        size="sm"
                        color="lunar-yellow"
                      >
                        {tag}
                      </Chip>
                    ))}
                  </div>
                )}

                {item.actions && item.actions.length > 0 && (
                  <div class="flex flex-wrap items-center gap-3 pt-1">
                    {item.actions.map((action) => {
                      const isSecondary = action.variant === "secondary";
                      return (
                        <ActionButton
                          href={action.href}
                          variant={isSecondary ? "outlined" : "filled"}
                          color={isSecondary ? "easton-blue" : "mashle-red"}
                        >
                          {action.label}
                        </ActionButton>
                      );
                    })}
                  </div>
                )}
              </div>

              <!-- Slot opcional para ilustración personalizada -->
              <div class="flex min-h-72 flex-col justify-between rounded-2xl border border-wand-brown-300/50 bg-lunar-yellow-100 p-5 sm:p-6">
                <div class="flex flex-1 items-center justify-center">
                  <slot name={`illustration-${idx}`}>
                    <div class="w-full max-w-md rounded-xl border border-easton-blue-500 bg-chalk-paper p-4 shadow-[4px_4px_0_0_var(--color-easton-blue-500)]">
                      <div class="mb-3 flex items-center gap-1.5 border-b border-wand-brown-300/40 pb-2">
                        <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-mashle-red-500" />
                        <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-lunar-yellow-500" />
                        <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#27c93f]" />
                      </div>
                      <div class="grid grid-cols-1 gap-2 md:grid-cols-3 xl:grid-cols-1 font-mono text-[10px] text-easton-blue-500">
                        <div class="rounded border border-wand-brown-300/40 bg-vellum-sheet p-2">
                          FLUJO ACTIVO
                        </div>
                        <div class="rounded border border-wand-brown-300/40 bg-vellum-sheet p-2">
                          MÉTRICAS
                        </div>
                        <div class="rounded border border-wand-brown-300/40 bg-vellum-sheet p-2">
                          ESTADO OK
                        </div>
                      </div>
                    </div>
                  </slot>
                </div>

                {item.illustrationLabel && (
                  <p class="mt-4 font-mono text-[11px] tracking-widest text-wand-brown-500/80">
                    {item.illustrationLabel}
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- PESTAÑA COLAPSADA -->
        <button
          type="button"
          data-accordion-trigger
          aria-expanded={isExpanded ? "true" : "false"}
          class:list={[
            "flex w-full min-h-[4.5rem] cursor-pointer items-center justify-between gap-4 px-5 py-3 text-left transition-opacity duration-300",
            "lg:h-full lg:min-h-0 lg:flex-col lg:justify-between lg:px-0 lg:py-8 lg:text-center",
            isExpanded
              ? "pointer-events-none absolute inset-0 opacity-0"
              : "relative opacity-100 delay-150",
          ]}
        >
          <span class="font-mono text-xs font-semibold tracking-widest text-wand-brown-500">
            {itemIndex}
          </span>

          <span class="font-display text-base font-bold text-easton-blue-500 lg:[writing-mode:vertical-rl] lg:rotate-180 lg:text-xl lg:tracking-wide">
            {item.shortTitle}
          </span>

          <span
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-easton-blue-500 font-mono text-xl font-bold text-chalk-paper transition-transform duration-500 ease-out group-hover:scale-105"
            aria-hidden="true"
          >
            +
          </span>
        </button>
      </article>
    );
  })}
</div>

<script>
  const accordions = document.querySelectorAll<HTMLElement>(
    "[data-vertical-accordion]",
  );

  accordions.forEach((accordion) => {
    const panels = Array.from(
      accordion.querySelectorAll<HTMLElement>("[data-accordion-panel]"),
    );

    function activatePanel(targetPanel: HTMLElement) {
      panels.forEach((panel) => {
        const isSelected = panel === targetPanel;
        const content = panel.querySelector<HTMLElement>(
          "[data-accordion-content]",
        );
        const trigger = panel.querySelector<HTMLButtonElement>(
          "[data-accordion-trigger]",
        );

        panel.dataset.expanded = String(isSelected);
        trigger?.setAttribute("aria-expanded", String(isSelected));
        content?.setAttribute("aria-hidden", String(!isSelected));

        if (isSelected) {
          panel.classList.remove("p-0", "lg:flex-[0_0_6rem]");
          panel.classList.add("p-6", "sm:p-8", "lg:flex-[1_1_0%]", "lg:p-10");

          content?.classList.remove(
            "pointer-events-none",
            "grid-rows-[0fr]",
            "opacity-0",
            "lg:h-0",
          );
          content?.classList.add(
            "grid-rows-[1fr]",
            "opacity-100",
            "delay-100",
            "lg:h-full",
          );

          trigger?.classList.remove("relative", "opacity-100", "delay-150");
          trigger?.classList.add(
            "pointer-events-none",
            "absolute",
            "inset-0",
            "opacity-0",
          );
        } else {
          panel.classList.remove(
            "p-6",
            "sm:p-8",
            "lg:flex-[1_1_0%]",
            "lg:p-10",
          );
          panel.classList.add("p-0", "lg:flex-[0_0_6rem]");

          content?.classList.remove(
            "grid-rows-[1fr]",
            "opacity-100",
            "delay-100",
            "lg:h-full",
          );
          content?.classList.add(
            "pointer-events-none",
            "grid-rows-[0fr]",
            "opacity-0",
            "lg:h-0",
          );

          trigger?.classList.remove(
            "pointer-events-none",
            "absolute",
            "inset-0",
            "opacity-0",
          );
          trigger?.classList.add("relative", "opacity-100", "delay-150");
        }
      });
    }
    panels.forEach((panel) => {
      const trigger = panel.querySelector<HTMLButtonElement>(
        "[data-accordion-trigger]",
      );
      trigger?.addEventListener("click", () => {
        activatePanel(panel);
      });
    });
  });
</script>
