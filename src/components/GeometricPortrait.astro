---
// src/components/GeometricPortrait.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
}

const {
  src = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80",
  alt = "Retrato en composición geométrica",
} = Astro.props;
---

<div class="mx-auto w-full max-w-[340px] select-none">
  <!-- Contenedor principal en Grid de 12 columnas para alinear proporciones -->
  <div class="grid grid-cols-12">
    <!-- FILA SUPERIOR: Rectángulo rojo (8 cols) + Círculo naranja/marrón (4 cols) -->
    <div class="col-span-8 h-24 bg-mashle-red-500"></div>
    <div class="col-span-4 flex items-center justify-center">
      <div class="aspect-square w-full rounded-full bg-wand-brown-600"></div>
    </div>

    <!-- FILA CENTRAL: Cápsula/Arco con imagen (esquina sup-izq e inf-der muy redondeadas) -->
    <div class="col-span-12">
      <div class="relative aspect-[3/4.2] w-full overflow-hidden rounded-tl-[110px] rounded-br-[110px] bg-easton-blue-600">
        {typeof src === "string" ? (
          <img
            src={src}
            alt={alt}
            class="h-full w-full object-cover object-center"
          />
        ) : (
          <Image
            src={src}
            alt={alt}
            class="h-full w-full object-cover object-center"
          />
        )}
      </div>
    </div>

    <!-- FILA INFERIOR 1: Cuadrado/Rectángulo azul a la izquierda (5 cols) -->
    <div class="col-span-5 aspect-[5/4] bg-easton-blue-600"></div>
    <div class="col-span-7"></div>

    <!-- FILA INFERIOR 2: Semicírculo superior (5 cols) + Bloque amarillo en esquina inferior derecha -->
    <div class="col-span-5">
      <div class="aspect-[2/1] w-full rounded-t-full bg-easton-blue-500"></div>
    </div>
    <div class="col-span-6"></div>
    <div class="col-span-1 flex items-end">
      <div class="h-10 w-full bg-lunar-yellow-700"></div>
    </div>
  </div>
</div>
